DEVICE_NAME = 'device_name'
# OS version: names the generated package (<device>_<os-version>) and feeds
# --device-version. Also read from $DEVICE_VERSION by the compilers.
DEVICE_VERSION = '1.4.0'
DEVICE_IP = '192.168.137.42'
DEVICE_USER = 'username'
DEVICE_PASS = 'password'
# Optional NETCONF SSH public-key authentication. A key is an alternative to
# DEVICE_PASS for NETCONF (RESTCONF still needs the password). Point
# DEVICE_SSH_KEY at the private key or at its OpenSSH `<key>-cert.pub`
# certificate; paramiko loads the adjacent private key for the latter, so it
# must exist.
# If both DEVICE_PASS and DEVICE_SSH_KEY are set, NETCONF uses the key and
# logs a warning; explicit arguments win by source. An encrypted key's
# passphrase can also be tried as a password by ncclient if key auth fails.
# DEVICE_SSH_KEY = '~/.ssh/id_ed25519'
# DEVICE_SSH_KEY_PASSPHRASE = 'key-passphrase'
RESTCONF_PORT = 443
NETCONF_PORT = 830
