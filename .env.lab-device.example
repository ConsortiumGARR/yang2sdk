# Real lab device (LAB ONLY, shared equipment). Names only, dummy values.
# The generated SDK and the test-suite resolve these names; nothing here is
# ever printed, logged, or committed. `.env` itself is gitignored.
#
# Fallback: the legacy DEVICE_* names keep working for `yang-downloader`
# and `sdk-verify`, so an existing .env does not need to change.
LAB_DEVICE_IP=192.0.2.10
LAB_DEVICE_NETCONF_PORT=830
LAB_DEVICE_USER=netconf-operator
LAB_DEVICE_PASS=change-me

# Optional: pin the device host key so the secure default (verify=True)
# works end to end. Without it the client fails closed, which is correct.
#LAB_DEVICE_KNOWN_HOSTS=/path/to/known_hosts
# Explicit lab opt-out; logs a warning and skips host-key verification.
#LAB_DEVICE_ALLOW_UNVERIFIED=1

# Gates the write test. Writes are off unless this is exactly 1.
LAB_DEVICE_ALLOW_WRITE=0
