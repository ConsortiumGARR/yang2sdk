# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
*.log

# Virtual environments
.venv
.ruff_cache
.pytest_cache/

# env files
*.env

# containerlab runtime state (LAB ONLY) — lives next to the topology file
tests/srl/clab-*/

# Temporary files
digest.txt
# Simulator snapshot payloads (run-local; strict golden comparison is follow-up)
tests/fixtures/golden/*.json
# Ephemeral workspace (yang_modules/, *_clients/, yang_tree/, verify/,
# model_gaps/). Never committed; every writer creates its own output dir
# on demand, so `rm -rf temp/` is always recoverable (re-download/recompile).
temp/