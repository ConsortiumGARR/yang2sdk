import logging
from enum import Enum
from typing import Annotated, Any, Generic, TypeVar, get_args, get_origin, Union
import types
from lxml import etree
from pydantic import BaseModel, ValidationError
from ..session_manager import NetconfClient, validate_depth, MODULE_NAMESPACES

log = logging.getLogger(__name__)

# Inverted once at import: an instance-identifier names each node by its
# DEFINING module (RFC 7951 Sec 6.11), and the path tuples carry namespaces.
# The compile-time map is the authority here -- the device's <hello> describes
# what the peer speaks, not which module a compiled node came from, and
# `client.module_namespaces` is overlaid with it after construction.
NAMESPACE_MODULES: dict[str, str] = {
    ns: name for name, ns in MODULE_NAMESPACES.items()
}


def _child_model_and_kind(annotation: Any) -> tuple[type | None, bool]:
    """Unwrap a field annotation to (nested model, is_yang_list).

    `is_yang_list` is True only for a YANG `list` (a list of models). A
    leaf-list is a list of primitives and is leaf-like, so it returns
    (None, False); that distinction is what lets the depth filter keep a
    leaf-list at the boundary while dropping a keyless list.
    """
    if annotation is None:
        return None, False
    origin = get_origin(annotation)
    if origin in (Union, types.UnionType):
        for arg in get_args(annotation):
            child, is_list = _child_model_and_kind(arg)
            if child is not None or is_list:
                return child, is_list
        return None, False
    if origin is Annotated:
        for arg in get_args(annotation):
            child, is_list = _child_model_and_kind(arg)
            if child is not None or is_list:
                return child, is_list
        return None, False
    if origin in (list, tuple, set):
        for arg in get_args(annotation):
            child, _ = _child_model_and_kind(arg)
            if child is not None:
                return child, True
        return None, False
    if isinstance(annotation, type) and issubclass(annotation, BaseModel):
        return annotation, False
    return None, False


def _field_key_info(model_cls: type) -> dict[str, tuple[str, str | None]]:
    """Map wire key name -> (python field name, key namespace) for a list model."""
    keys: dict[str, tuple[str, str | None]] = {}
    for name, field_info in model_cls.model_fields.items():
        extra = field_info.json_schema_extra or {}
        if extra.get("is_key"):
            keys[extra.get("tag", name)] = (name, extra.get("ns"))
    return keys


def _matches(element: etree._Element, tag: str, ns: str | None) -> bool:
    qname = etree.QName(element)
    return qname.localname == tag and (not ns or qname.namespace == ns)


def _new_element(ns: str | None, tag: str) -> etree._Element:
    return etree.Element(
        "{" + ns + "}" + tag if ns else tag,
        nsmap={None: ns} if ns else None,
    )


def _append_key_children(
    parent: etree._Element, model_cls: type, fallback_ns: str | None
) -> None:
    """Append empty key leaves: selection nodes, never content matches.

    An empty key leaf selects the key without narrowing the sibling set, so a
    keyed list remains addressable at the depth boundary without selecting the
    list's whole subtree (RFC 6241 Sec 6.2.5).
    """
    for key_tag, (_field_name, key_ns) in _field_key_info(model_cls).items():
        parent.append(_new_element(key_ns or fallback_ns, key_tag))


def _is_key_element(element: etree._Element, model_cls: type) -> bool:
    for name, field_info in model_cls.model_fields.items():
        extra = field_info.json_schema_extra or {}
        if extra.get("is_key") and _matches(
            element, extra.get("tag", name), extra.get("ns")
        ):
            return True
    return False


def _is_whole_subtree_trigger(element: etree._Element) -> bool:
    """True when an empty filter element would select the whole subtree.

    RFC 6241 Sec 6.2.1/6.2.4: an empty element is a selection node and selects
    that node's entire subtree. Sec 6.2.5: a sibling set holding only content
    match nodes (text, no selection node) returns the matched node with all of
    its siblings. Both shapes are triggers; a complex element must retain at
    least one empty child (a selection node) to stay bounded.
    """
    if len(element) == 0:
        return True
    return all(
        child.text is not None and len(child) == 0 for child in element
    )


def _build_path(
    path_tuples: list[tuple[str, str, dict[str, Any]]],
) -> tuple[etree._Element | None, etree._Element | None]:
    """Build the address path, returning (root, target)."""
    root = current = None
    for ns, tag, keys in path_tuples:
        elem = _new_element(ns, tag)
        for key_name, value in keys.items():
            key_elem = _new_element(ns, key_name)
            key_elem.text = str(value)
            elem.append(key_elem)
        if root is None:
            root = current = elem
        else:
            current.append(elem)
            current = elem
    return root, current


def _populate_depth(
    element: etree._Element,
    model_cls: type,
    level: int,
    depth: int,
    fields: list[str] | None = None,
    is_list_entry_target: bool = False,
) -> None:
    """Add selection nodes for levels up to `depth`, never a whole subtree.

    `level` is the level of `element` itself; the target is level 1. A list
    node and its entries share a level, so an entry's fields sit at
    `level + 1`. Keys are the addressability exception: they are always
    emitted for a list collection or a nested list, even past the boundary.
    A specific list-item target is different -- its path keys are already
    content matches, and adding empty key children there would turn the
    content match into a selection over every entry.
    """
    child_level = level + 1
    key_info = _field_key_info(model_cls)
    if key_info and not is_list_entry_target:
        _append_key_children(
            element, model_cls, etree.QName(element).namespace
        )
    if fields is None:
        selected = list(model_cls.model_fields.items())
    else:
        selected = [
            (name, model_cls.model_fields[name])
            for name in fields
            if name in model_cls.model_fields
        ]
    seen: set[str] = {field_name for field_name, _ns in key_info.values()}
    for name, field_info in selected:
        if name in seen or name == "nc_operation":
            continue
        extra = field_info.json_schema_extra or {}
        tag = extra.get("tag")
        if not tag:
            continue
        seen.add(name)
        if extra.get("is_key") is True:
            # Keys were added above for a collection/nested list. For a
            # specific item target the path key is already the content match.
            continue
        ns = extra.get("ns")
        child_cls, is_list = _child_model_and_kind(field_info.annotation)
        if child_cls is None:
            if child_level <= depth:
                element.append(_new_element(ns, tag))
            continue
        if child_level < depth:
            child = _new_element(ns, tag)
            element.append(child)
            _populate_depth(child, child_cls, child_level, depth)
        elif child_level == depth and is_list and _field_key_info(child_cls):
            # Boundary keyed list: keys only, so entries stay addressable.
            child = _new_element(ns, tag)
            element.append(child)
            _append_key_children(child, child_cls, ns)
        # A boundary container or keyless list is not added: an empty one
        # would select its whole subtree (RFC 6241 Sec 6.2.1).


def _remove_whole_subtree_triggers(element: etree._Element, model_cls: type) -> None:
    """Post-order removal of complex children that would fetch a whole subtree."""
    for field_info in model_cls.model_fields.values():
        extra = field_info.json_schema_extra or {}
        tag = extra.get("tag")
        if not tag:
            continue
        child_cls, _is_list = _child_model_and_kind(field_info.annotation)
        if child_cls is None:
            continue
        for child in list(element):
            if not _matches(child, tag, extra.get("ns")):
                continue
            _remove_whole_subtree_triggers(child, child_cls)
            if _is_whole_subtree_trigger(child):
                element.remove(child)


def build_depth_filter(
    path_tuples: list[tuple[str, str, dict[str, Any]]],
    model_cls: type,
    depth: int,
    fields: list[str] | None = None,
) -> etree._Element | None:
    """Build an RFC 6241 subtree filter that cannot select past `depth`.

    Returns None when the target itself would have to be an empty element
    (or a content-match-only sibling set). The caller must then not send the
    filter and return a skeleton instead. This is the legacy-NETCONF guard:
    RFC 6241 has no server-side depth, so the filter is the only ceiling.
    """
    root, target = _build_path(path_tuples)
    if target is None:
        return None
    is_list_entry_target = bool(path_tuples and path_tuples[-1][2])
    _populate_depth(
        target,
        model_cls,
        1,
        depth,
        fields=fields,
        is_list_entry_target=is_list_entry_target,
    )
    _remove_whole_subtree_triggers(target, model_cls)
    if _is_whole_subtree_trigger(target):
        return None
    return root


class _SkeletonList(list):
    """The `[]` returned when a finite-depth list filter collapsed.

    The marker lets `sdk-verify` report a skeleton as a skip rather than a
    validated read: no request was issued, so nothing was proven about the
    device.
    """

    _yang2sdk_skeleton = True


def _skeleton_model(
    model_cls: type, path_tuples: list[tuple[str, str, dict[str, Any]]]
) -> Any:
    """Build the RESTCONF-shaped empty value for a collapsed target.

    A container is an empty model; a keyed list item carries the path keys.
    `model_validate` is tried first so the skeleton has the same validation
    semantics as a real read. A strict model with mandatory fields cannot
    validate an empty container, and this path must never raise, so the
    deliberate fallback is `model_construct` plus a warning.
    """
    key_info = _field_key_info(model_cls)
    values: dict[str, Any] = {}
    if path_tuples:
        for wire_name, value in path_tuples[-1][2].items():
            field_name, _ns = key_info.get(wire_name, (wire_name, None))
            values[field_name] = value
    try:
        model = model_cls.model_validate(values)
    except ValidationError:
        log.warning(
            "Skeleton for %s cannot satisfy mandatory fields; returning an "
            "unvalidated model_construct() instance.",
            model_cls.__name__,
        )
        model = model_cls.model_construct(**values)
    object.__setattr__(model, "_yang2sdk_skeleton", True)
    return model


def prune_xml_tree_to_depth(
    element: etree._Element,
    model_cls: type | None,
    max_depth: int,
    current_depth: int = 1,
):
    """Prune a reply to RFC 8040/RFC 8526 depth semantics (safety net).

    The target node is level 1; a list node and its entries share that level,
    so an entry's children are one level deeper. Nodes through `max_depth`
    survive, with two exceptions: list keys always survive for addressability
    (even at max_depth + 1), and a keyed list sitting exactly on the boundary
    keeps its keys while its other children are removed. Boundary containers
    and keyless lists are removed entirely. `anydata`/`anyxml` are leaf-like,
    so their internal content is not depth-counted.

    This runs even when a server-side filter was used, because a server may
    return more than asked. It cannot undo bytes already received; it only
    keeps the caller's model bounded.
    """
    if model_cls is None or max_depth is None:
        return
    # Pure metadata walk: `model_fields` / `json_schema_extra` exist as soon as
    # the class is created, so pruning must never trigger a pydantic schema
    # build. It used to call `rebuild_model_and_dependencies` here, which built
    # the whole model graph (1355 classes / 34s cold on G30) before the reply
    # was even parsed -- once per recursion level.
    if not hasattr(model_cls, "model_fields"):
        return

    for field_info in model_cls.model_fields.values():
        extra = field_info.json_schema_extra or {}
        tag = extra.get("tag")
        if not tag:
            continue
        is_key = extra.get("is_key") is True
        child_cls, is_list = _child_model_and_kind(field_info.annotation)
        for child in list(element):
            if not _matches(child, tag, extra.get("ns")):
                continue
            if child_cls is None:
                if is_key or current_depth + 1 <= max_depth:
                    continue
                element.remove(child)
                continue
            child_level = current_depth + 1
            if child_level < max_depth:
                prune_xml_tree_to_depth(child, child_cls, max_depth, child_level)
            elif child_level == max_depth:
                if is_list and _field_key_info(child_cls):
                    for grandchild in list(child):
                        if not _is_key_element(grandchild, child_cls):
                            child.remove(grandchild)
                else:
                    element.remove(child)
            else:
                element.remove(child)


def prune_xml_to_content(
    element: etree._Element,
    model_cls: type | None,
    content: str,
    preserve_keys: bool = False,
):
    """Keep only the nodes matching `content` (RFC 7950 Sec 7.21).

    This mirrors the RESTCONF `YangBaseModel._prune_content` rule exactly, so
    `content=` means the same thing on both transports. RESTCONF's rule
    (restconf/data_models/_base.py.jinja:91-110) is bottom-up:

      * recurse into a container/list first;
      * a node MISMATCHING `content` is dropped, UNLESS it is a container or
        list still holding a matchable descendant -- then the ancestor shell
        survives, so RFC 8040 hierarchy is preserved;
      * a node MATCHING `content` is always kept, even once emptied.

    Why NETCONF needs it: `content=` reaches the wire three ways and RFC 6241
    cannot express one of them. NMDA sends `<config-filter>` (RFC 8526);
    RESTCONF sends `?content=` (RFC 8040 Sec 4.5.2); legacy NETCONF maps
    `config` to `<get-config>` but `nonconfig` to `<get>`, which RFC 6241
    Sec 7.7 defines as state AND running configuration, with no state-only
    read. Pruning here is what makes the caller's view match the others.

    Keys are addressability metadata. A `content="nonconfig"` read of a config
    list keeps the state children but must also keep the list's keys, or the
    entries cannot be addressed. `preserve_keys` is therefore propagated into
    a list entry and the list is dropped only when nothing but keys remains
    and the list itself does not match `content`.

    Idempotent where the server already filtered, so it is safe to apply
    unconditionally rather than branching on capability a second time.
    """
    if content not in ("config", "nonconfig"):
        return
    if model_cls is None:
        return
    # Pure metadata walk, for the same reason as `prune_xml_tree_to_depth`.
    if not hasattr(model_cls, "model_fields"):
        return

    keep_config = content == "config"

    for field_name, field_info in list(model_cls.model_fields.items()):
        extra = field_info.json_schema_extra or {}
        tag = extra.get("tag", field_name)
        if not extra.get("tag"):
            continue
        ns = extra.get("ns")
        # A missing is_config means config-ness is not defined for this node
        # (rpc/action/notification subtrees). RESTCONF treats that as config,
        # because treating it as state pruned real parameters out of a
        # content="config" read. Match that, so the transports agree.
        is_config = extra.get("is_config") is not False
        is_key = extra.get("is_key") is True
        match = keep_config == is_config
        sub, is_list = _child_model_and_kind(field_info.annotation)

        for child_node in list(element):
            if not _matches(child_node, tag, ns):
                continue
            if sub is not None:
                prune_xml_to_content(
                    child_node, sub, content, preserve_keys=is_list
                )
            if is_key and preserve_keys:
                continue
            if is_list and sub is not None:
                # A list shell survives only when a non-key descendant
                # survived; otherwise its preserved keys alone must not keep
                # a state list in a config-only read.
                keep_shell = any(
                    not _is_key_element(grandchild, sub)
                    for grandchild in child_node
                )
            else:
                keep_shell = sub is not None and len(list(child_node)) > 0
            if not match and not keep_shell:
                element.remove(child_node)

def _require_complete_for_replace(data, allow_partial: bool, model_cls=None) -> None:
    """Refuse an `nc:operation="replace"` that would delete unset fields.

    RFC 6241 Sec 8.2.1: with nc:operation="replace" on a node, the server
    replaces that node's *entire* contents, so any child absent from the
    payload is removed. A hand-built model -- or one read at a shallower depth
    -- omits fields, and the previous code sent it anyway, quietly deleting
    them. A round-trip (retrieve -> modify -> replace) is unaffected because
    every field the device returned is "set".
    """
    if allow_partial:
        return
    if not hasattr(data, "model_fields"):
        # `replace()` accepts a dict or an XML/JSON string exactly as readily
        # as a model, and the caller coerces it *after* this guard runs. Left
        # uncoerced, a plain dict raised an opaque
        # `AttributeError: 'dict' object has no attribute 'model_fields'`, which
        # is both a bad error and a silent bypass of the safety check for the
        # most convenient input form. Coerce with the same rules `update()`
        # uses, so the check always sees a model.
        if data is None:
            raise ValueError("replace() needs a model, dict, or XML/JSON string.")
        if model_cls is None:
            raise TypeError(
                f"replace() cannot inspect {type(data).__name__}; pass the model "
                f"instance, or allow_partial=True to skip the completeness check."
            )
        if isinstance(data, dict):
            data = model_cls.model_validate(data)
        elif isinstance(data, str) and data.strip().startswith("<"):
            data = model_cls.from_xml(data)
        else:
            data = model_cls.model_validate_json(data)
    # nc_operation is the nc:operation *attribute*, not a data node; it is
    # never part of the resource contents.
    # `config false` (state) fields never appear in a config body and cannot be
    # deleted by an edit, so counting them reported every state leaf of a
    # partially-read interface as "would be deleted". Only config nodes are at
    # risk, and `nc_operation` is an attribute rather than a data node.
    unset = [
        name
        for name, info in data.model_fields.items()
        if name != "nc_operation"
        and name not in data.model_fields_set
        and (info.json_schema_extra or {}).get("is_config") is not False
    ]
    if not unset:
        return
    shown = ", ".join(sorted(unset)[:12])
    more = f" (+{len(unset) - 12} more)" if len(unset) > 12 else ""
    raise ValueError(
        f"replace() on {type(data).__name__} would DELETE {len(unset)} field(s) "
        f"that are not set, because nc:operation=\"replace\" replaces the whole "
        f"node (RFC 6241 Sec 8.2.1): {shown}{more}. "
        f"Use update() to merge, retrieve the node at full depth first, or pass "
        f"allow_partial=True if deleting them is what you intend."
    )


def build_filter_tree(path_tuples: list[tuple[str, str, dict[str, Any]]], model_cls: type | None = None, fields: list[str] | None = None) -> etree._Element:
    """Builds a precise RFC 6241 selection node without sending exhaustive trees."""
    root = current = None
    for ns, tag, keys in path_tuples:
        elem = etree.Element("{" + ns + "}" + tag if ns else tag, nsmap={None: ns} if ns else None)
        for k, v in keys.items():
            key_elem = etree.Element("{" + ns + "}" + k if ns else k)
            key_elem.text = str(v)
            elem.append(key_elem)
            
        if root is None: root = current = elem
        else:
            current.append(elem)
            current = elem

    # If specific fields are requested, explicitly append them to the filter node.
    # Otherwise, we leave the node empty to retrieve the full subtree from the device.
    if current is not None and fields and model_cls:
        for field_name in fields:
            field_info = getattr(model_cls, "model_fields", {}).get(field_name)
            if field_info:
                extra = field_info.json_schema_extra or {}
                f_ns = extra.get("ns", path_tuples[-1][0] if path_tuples else "")
                f_tag = extra.get("tag", field_name)
                current.append(etree.Element("{" + f_ns + "}" + f_tag if f_ns else f_tag, nsmap={None: f_ns} if f_ns else None))

    return root

def find_xml_node(root_element: etree._Element | None, path_tuples: list[tuple[str, str, dict[str, Any]]]) -> etree._Element | None:
    if root_element is None:
        return None
    current = root_element
    for ns, tag, keys in path_tuples:
        found = None
        for child in current:
            if etree.QName(child).localname == tag and (not ns or etree.QName(child).namespace == ns):
                match = True
                for k, v in keys.items():
                    key_child = child.find("./{" + ns + "}" + k if ns else f"./{k}")
                    if key_child is None:
                        key_child = child.find(f"./{k}")
                    if key_child is None or key_child.text != str(v):
                        match = False
                        break
                if match:
                    found = child
                    break
        if found is None:
            return None
        current = found
    return current

def find_xml_nodes(root_element: etree._Element | None, path_tuples: list[tuple[str, str, dict[str, Any]]]) -> list[etree._Element]:
    if root_element is None or not path_tuples:
        return []
    parent = find_xml_node(root_element, path_tuples[:-1]) if len(path_tuples) > 1 else root_element
    if parent is None:
        return []
    
    last_ns, last_tag, last_keys = path_tuples[-1]
    results = []
    for child in parent:
        if etree.QName(child).localname == last_tag and (not last_ns or etree.QName(child).namespace == last_ns):
            match = True
            for k, v in last_keys.items():
                key_child = child.find("./{" + last_ns + "}" + k if last_ns else f"./{k}")
                if key_child is None:
                    key_child = child.find(f"./{k}")
                if key_child is None or key_child.text != str(v):
                    match = False
                    break
            if match:
                results.append(child)
    return results


def retrieve_bounded(
    client: NetconfClient,
    path: list[tuple[str, str, dict[str, Any]]],
    model_cls: type,
    *,
    is_list_collection: bool = False,
    source: str | None = None,
    content: str = "all",
    with_defaults: str = "report-all",
    depth: int | str = 2,
    fields: list[str] | None = None,
) -> Any:
    """Retrieve one navigator target under a depth ceiling.

    Legacy NETCONF (no NMDA) has no server-side depth, so the generated
    subtree filter is the ceiling. When the filter would collapse to an
    empty target -- a container at depth 1, a keyless list at depth 1, a
    specific list item whose only remaining children are its path keys, or
    any target whose kept children all sit on the boundary -- it is not sent
    at all: an empty element selects the whole subtree (RFC 6241 Sec 6.2.1)
    and the caller gets a skeleton instead, with a warning.

    NMDA sends `max-depth` (RFC 8526 Sec 3.1.2) and keeps the simple target
    filter, because the server enforces the ceiling. RESTCONF is not this
    module; it uses `?depth=` (RFC 8040 Sec 4.8.2). In both cases the reply
    is still pruned locally as a safety net.
    """
    requested = validate_depth(depth)
    label = "/".join(tag for _ns, tag, _keys in path)
    if requested is not None and not getattr(client, "has_nmda", False):
        xml_filter = build_depth_filter(path, model_cls, requested, fields=fields)
        if xml_filter is None:
            log.warning(
                "depth=%s on %s would select the whole subtree; returning a "
                "skeleton without reading the device.",
                requested,
                label,
            )
            if is_list_collection:
                return _SkeletonList()
            return _skeleton_model(model_cls, path)
    else:
        # Unbounded is the only case allowed to leave the target empty, and
        # NMDA is bounded by max-depth on the server.
        xml_filter = build_filter_tree(path, model_cls, fields=fields)

    if xml_filter is not None and log.isEnabledFor(logging.DEBUG):
        log.debug(
            "depth=%s on %s: sending a %d-element/%d-byte subtree filter",
            depth,
            label,
            sum(1 for _node in xml_filter.iter()),
            len(etree.tostring(xml_filter)),
        )

    xml_data = client.retrieve(
        source=source,
        filter_xml=xml_filter,
        content=content,
        with_defaults=with_defaults,
        depth=depth,
    )
    if xml_data is None:
        return [] if is_list_collection else None

    module_namespaces = getattr(client, "module_namespaces", {})
    if is_list_collection:
        matched = find_xml_nodes(xml_data, path)
        result = []
        for node in matched:
            if requested is not None:
                prune_xml_tree_to_depth(node, model_cls, requested)
            prune_xml_to_content(node, model_cls, content)
            result.append(
                model_cls.from_xml(
                    etree.tostring(node),
                    module_namespaces=module_namespaces,
                )
            )
        return result

    matched = find_xml_node(xml_data, path)
    if matched is None:
        return None
    if requested is not None:
        prune_xml_tree_to_depth(matched, model_cls, requested)
    prune_xml_to_content(matched, model_cls, content)
    return model_cls.from_xml(
        etree.tostring(matched),
        module_namespaces=module_namespaces,
    )


def wrap_in_parent_hierarchy(element: etree._Element, path_tuples: list[tuple[str, str, dict[str, Any]]]) -> etree._Element:
    current = element
    for ns, tag, keys in reversed(path_tuples[:-1]):
        parent_elem = etree.Element("{" + ns + "}" + tag if ns else tag, nsmap={None: ns} if ns else None)
        for k, v in keys.items():
            key_elem = etree.Element("{" + ns + "}" + k if ns else k)
            key_elem.text = str(v)
            parent_elem.append(key_elem)
        parent_elem.append(current)
        current = parent_elem
    return current


def wrap_list_in_parent_hierarchy(elements: list[etree._Element], path_tuples: list[tuple[str, str, dict[str, Any]]]) -> list[etree._Element]:
    if not path_tuples or len(path_tuples) < 2:
        return elements
        
    parent_ns, parent_tag, parent_keys = path_tuples[-2]
    parent_elem = etree.Element("{" + parent_ns + "}" + parent_tag if parent_ns else parent_tag, nsmap={None: parent_ns} if parent_ns else None)
    for k, v in parent_keys.items():
        key_elem = etree.Element("{" + parent_ns + "}" + k if parent_ns else k)
        key_elem.text = str(v)
        parent_elem.append(key_elem)
        
    for elem in elements: parent_elem.append(elem)
        
    current = parent_elem
    for ns, tag, keys in reversed(path_tuples[:-2]):
        anc_elem = etree.Element("{" + ns + "}" + tag if ns else tag, nsmap={None: ns} if ns else None)
        for k, v in keys.items():
            key_elem = etree.Element("{" + ns + "}" + k if ns else k)
            key_elem.text = str(v)
            anc_elem.append(key_elem)
        anc_elem.append(current)
        current = anc_elem
        
    return [current]


def _predicate_value(value: Any) -> str:
    """Render a key value as an RFC 7950 Sec 14 ``quoted-string``.

    The value must be the key leaf's LEXICAL form, not Python's repr: a boolean
    key is ``true``/``false`` (Sec 9.7.2) and an enumeration key is its assigned
    name (Sec 9.6.4), whereas ``str()`` yields ``True`` and ``Color.RED`` -- both
    silently name a different value.
    """
    if isinstance(value, bool):
        text = "true" if value else "false"
    elif isinstance(value, Enum):
        text = value.name
    elif value is None:
        raise ValueError(
            "a key value cannot be None: RFC 7950 Sec 7.8.2 requires every key "
            "leaf to have a value in an instance-identifier predicate (an "
            "`empty` key has none -- pass an empty string, Sec 9.13)"
        )
    else:
        text = str(value)
    # `quoted-string` has no escape mechanism (Sec 14), so a value holding both
    # quote characters cannot be represented at all. Emitting it anyway would
    # produce a string that parses as a different path.
    if "'" not in text:
        return f"'{text}'"
    if '"' not in text:
        return f'"{text}"'
    raise ValueError(
        f"key value {value!r} contains both quote characters, and RFC 7950 "
        "Sec 14 `quoted-string` has no escape form, so it cannot appear in an "
        "instance-identifier"
    )


class Node:
    # Generated RPC/action navigators override this: an instance-identifier
    # addresses nodes in the DATA tree (RFC 7950 Sec 9.13), and rpc/action
    # input/output nodes are not data nodes (Sec 7.15).
    _yang_node_kind = "data"

    def __init__(self, client: NetconfClient, path: list[tuple[str, str, dict]] = None):
        self._client = client
        self._path = path or []

    def instance_identifier(self) -> str:
        """This node as an RFC 7950 Sec 9.13 instance-identifier.

        Encoded per RFC 7951 Sec 6.11: the leftmost node is always
        module-qualified, and a later node is qualified only when its module
        differs from its parent's. One predicate per key, in key order, because
        Sec 9.13 requires every key to have one.
        """
        if not self._path:
            raise ValueError(
                "the datastore root is not an instance node, so it has no "
                "instance-identifier (RFC 7950 Sec 9.13)"
            )
        if self._yang_node_kind != "data":
            raise ValueError(
                "rpc/action nodes are not in the data tree (RFC 7950 Sec 7.15); "
                "an instance-identifier addresses data nodes only (Sec 9.13)"
            )
        rendered: list[str] = []
        previous: str | None = None
        for ns, tag, keys in self._path:
            module = NAMESPACE_MODULES.get(ns)
            if module is None:
                # A bare name would silently mean "same module as the parent"
                # (RFC 7951 Sec 6.11), i.e. a different identifier.
                raise ValueError(
                    f"no module name is known for namespace {ns!r} ({tag!r}); "
                    "cannot build a module-qualified instance-identifier"
                )
            segment = f"{module}:{tag}" if module != previous else tag
            if keys:
                # A key leaf is a child leaf of the list (RFC 7950 Sec 7.8.2)
                # bound to the list's module namespace (a grouping's nodes bind
                # to the module that uses them, Sec 7.13), so its predicate name
                # stays simple -- RFC 7951 Sec 6.11.
                segment += "".join(
                    f"[{key_name}={_predicate_value(value)}]"
                    for key_name, value in keys.items()
                )
            rendered.append(segment)
            previous = module
        return "/" + "/".join(rendered)


class ItemNode(Node): pass
TNode = TypeVar("TNode", bound=ItemNode)

class ListNode(Node, Generic[TNode]):
    def __init__(self, client: NetconfClient, item_cls: type[TNode], path: list = None):
        super().__init__(client, path)
        self._item_cls = item_cls

    def instance_identifier(self) -> str:
        raise ValueError(
            "a list collection is not an instance node; call the navigator with "
            "its keys first (RFC 7950 Sec 9.13 requires one predicate per key)"
        )

    def __call__(self, *keys: Any) -> TNode: raise NotImplementedError("Implemented by generated subclasses")