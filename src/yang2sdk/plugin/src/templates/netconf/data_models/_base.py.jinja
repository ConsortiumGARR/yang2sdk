import json
from enum import Enum
from typing import Annotated, Any, ClassVar, Literal, Self, get_args, get_origin, Union
import types
from pydantic import ConfigDict, BaseModel, BeforeValidator, model_validator
from pydantic_xml import BaseXmlModel, attr
from lxml import etree
from decimal import Decimal
import re

from ..session_manager import MODULE_NAMESPACES

NETCONF_BASE_NS = "urn:ietf:params:xml:ns:netconf:base:1.0"

# Inverted once at import: an instance-identifier names each node by its
# DEFINING module (RFC 7951 Sec 6.11), and the model metadata carries
# namespaces. The compile-time map is the authority here -- the device's
# <hello> describes what the peer speaks, not which module a compiled node
# came from, and `client.module_namespaces` is overlaid with it after
# construction. Both the navigators and `model_dump_instances()` use this one
# map.
NAMESPACE_MODULES: dict[str, str] = {
    ns: name for name, ns in MODULE_NAMESPACES.items()
}


def _predicate_value(value: Any) -> str:
    """Render a predicate value as an RFC 7950 Sec 14 ``quoted-string``.

    The value must be the node's LEXICAL form, not Python's repr: a boolean
    key is ``true``/``false`` (Sec 9.7.2) and an enumeration key is its
    assigned name (Sec 9.6.4) -- the generated enum's ``.value``, not its
    Python ``.name`` (``FOO_BAR`` for the YANG value ``foo-bar``). ``str()``
    on the enum would render ``ModeEnum.FOO_BAR``, silently naming a
    different value.
    """
    if isinstance(value, bool):
        text = "true" if value else "false"
    elif isinstance(value, Enum):
        text = str(value.value)
    elif value is None:
        raise ValueError(
            "a predicate value cannot be None: RFC 7950 Sec 7.8.2 requires "
            "every key leaf to have a value in an instance-identifier predicate "
            "(an `empty` key has none -- pass an empty string, Sec 9.13)"
        )
    else:
        text = str(value)
    # `quoted-string` has no escape mechanism (Sec 14), so a value holding both
    # quote characters cannot be represented at all. Emitting it anyway would
    # produce a string that parses as a different path.
    if "'" not in text:
        return f"'{text}'"
    if '"' not in text:
        return f'"{text}"'
    raise ValueError(
        f"predicate value {value!r} contains both quote characters, and "
        "RFC 7950 Sec 14 `quoted-string` has no escape form, so it cannot "
        "appear in an instance-identifier"
    )


def _module_name_for_model(model_cls: type) -> str:
    """The YANG module that defines ``model_cls``'s root node.

    A generated model's ``ns`` argument is a pydantic-xml *prefix alias* (empty
    for the file's default namespace, a prefix for an augmented node); the
    namespace URI is what identifies the module, and ``__xml_nsmap__`` is the
    only place it is resolved.
    """
    nsmap = getattr(model_cls, "__xml_nsmap__", None) or {}
    ns = nsmap.get(getattr(model_cls, "__xml_ns__", None) or "")
    module = NAMESPACE_MODULES.get(ns)
    if module is None:
        raise ValueError(
            f"no module name is known for namespace {ns!r} ({model_cls.__name__}); "
            "cannot build a module-qualified instance-identifier"
        )
    return module


def _instance_value(value: Any) -> Any:
    """The value as it belongs in a ``{instance-identifier: value}`` map.

    Enumerations become their YANG name (the generated enum's value) and
    decimal64 becomes a string, which is RFC 7951's JSON encoding. Everything
    else is already a JSON scalar (the model layer validates the type).
    """
    if isinstance(value, Enum):
        return value.value
    if isinstance(value, Decimal):
        return str(value)
    if isinstance(value, (bool, str, int, float)) or value is None:
        return value
    return str(value)


class NetconfXmlModel(BaseXmlModel, search_mode='unordered'):
    """Handles on-demand schema construction to bridge Pydantic v2's defer_build=True with pydantic-xml.

    search_mode='unordered' is inherited by every generated model
    (pydantic-xml model.py: __xml_search_mode__ falls back to the parent
    class). The default STRICT search is a single forward-only cursor with
    exact tag equality, so the *first* child the model does not know stalls the
    cursor and turns every later sibling into `extra_forbidden` — a
    single if-feature mismatch produced 127 phantom errors on SR Linux.
    A client must not depend on the order in which a server emits sibling
    data nodes: RFC 7950 Sec 7.7.1 lets the server sort list entries "in any
    reasonable order", and RFC 6241 Sec 5.2 treats the <config> contents as
    opaque data. UNORDERED consumes each match out of order while keeping
    the consumed prefix contiguous, so `_check_extra` still detects genuine
    unknown elements.
    """

    # Tolerate XML *attributes* a model cannot bind, drop unknown *elements*
    # never. RFC 7952 Sec 4.1: "An attribute MUST NOT be used to represent a
    # YANG leaf value" — attributes carry metadata, so an undeclared one
    # cannot hide or corrupt data. pydantic-xml reports unbound attributes
    # through the same `extra="forbid"` hook as unknown elements (it prefixes
    # their loc with "@"), so a device that stamps its own attribute on every
    # data node otherwise makes every read fail. The Groove G30 emits an
    # undeclared `cli-name` on every node, with no YANG declaration anywhere.
    #
    # Unknown ELEMENTS remain fatal: that is the model-gap safety net
    # (`--check-model-gaps` exists for exactly that case). Set this False on a
    # subclass to get strict-attribute behaviour back.
    ignore_unbound_attributes: ClassVar[bool] = True

    @classmethod
    def _drop_unbound_attributes(cls, root):
        """Remove attributes no generated model binds, before pydantic-xml reads.

        The only XML attribute a generated model ever binds is `nc:operation`
        (`NetconfBaseModel.nc_operation`); everything else on a data element
        is metadata. Namespaced `xmlns`/XSI attributes are never touched.
        """
        if not cls.ignore_unbound_attributes:
            return root
        for el in root.iter():
            if not isinstance(el.tag, str):
                continue
            for name in list(el.attrib):
                if name.startswith("{http://www.w3.org/2000/xmlns/}"):
                    continue
                qname = etree.QName(name)
                if qname.namespace == NETCONF_BASE_NS and qname.localname == "operation":
                    continue
                del el.attrib[name]
        return root

    @classmethod
    def from_xml(cls, source: str | bytes, *args: Any, module_namespaces: dict[str, str] | None = None, **kwargs: Any) -> Self:
        # Always parse to a tree: attribute handling has to see the elements.
        # (Passing an lxml element straight to pydantic-xml's from_xml() raises
        # "memoryview: a bytes-like object is required".)
        root = etree.fromstring(source)
        if module_namespaces:
            normalize_identityrefs(root, cls, module_namespaces)
        root = cls._drop_unbound_attributes(root)
        ensure_xml_models_built(root, cls)
        return super().from_xml_tree(root, *args, **kwargs)

    @classmethod
    def from_xml_tree(cls, root: etree._Element, *args: Any, module_namespaces: dict[str, str] | None = None, **kwargs: Any) -> Self:
        if module_namespaces:
            normalize_identityrefs(root, cls, module_namespaces)
        root = cls._drop_unbound_attributes(root)
        ensure_xml_models_built(root, cls)
        return super().from_xml_tree(root, *args, **kwargs)

    def to_xml(self, *args: Any, **kwargs: Any) -> bytes:
        ensure_instance_models_built(self)
        return super().to_xml(*args, **kwargs)


def _content_matches(is_config: bool, content: str) -> bool:
    """RFC 8342 / RFC 8526 config-filter semantics, shared with model_dump."""
    if content == "all":
        return True
    if content == "config":
        return is_config
    return not is_config


def _list_item_path(item: Any, parent_path: str, segment: str) -> str:
    """Instance path of one list entry, with RFC 7950 Sec 9.13 predicates.

    ``segment`` is already module-qualified relative to the parent. The
    predicates come from the item's key fields in `key`-statement order
    (``__yang_key_order__``); field declaration order is not key order.
    """
    key_order = getattr(type(item), "__yang_key_order__", ())
    if not key_order:
        raise ValueError(
            f"{type(item).__name__} is a keyless list entry. RFC 7950 Sec 7.8.2 "
            "allows keyless lists only for state data, and Sec 9.13 gives no "
            "instance-identifier for an individual entry; use content='config' "
            "to exclude state data"
        )
    by_yang_name: dict[str, str] = {}
    for field_name, field_info in type(item).model_fields.items():
        tag = (field_info.json_schema_extra or {}).get("tag")
        if isinstance(tag, str):
            by_yang_name[tag] = field_name
    predicates: list[str] = []
    for key_name in key_order:
        field_name = by_yang_name.get(key_name)
        if field_name is None:
            raise ValueError(
                f"{type(item).__name__} declares key {key_name!r} in "
                "__yang_key_order__ but has no field with that YANG name"
            )
        value = getattr(item, field_name)
        predicates.append(f"[{key_name}={_predicate_value(value)}]")
    return f"{parent_path}/{segment}{''.join(predicates)}"


def _collect_instances(
    model: Any,
    path: str,
    module: str,
    out: dict[str, Any],
    *,
    content: str,
    exclude_none: bool,
    exclude_unset: bool,
) -> None:
    """Walk ``model`` and add every populated leaf to ``out``.

    ``path`` is the instance-identifier of ``model`` itself; ``module`` is its
    defining module, used to decide whether a child needs RFC 7951 Sec 6.11
    module qualification.
    """
    for field_name, field_info in type(model).model_fields.items():
        # nc:operation is the RFC 6241 Sec 7.2 edit attribute, not a data node.
        if field_name == "nc_operation":
            continue
        extra = field_info.json_schema_extra or {}
        tag = extra.get("tag")
        ns = extra.get("ns")
        if not isinstance(tag, str) or not isinstance(ns, str):
            raise ValueError(
                f"{type(model).__name__}.{field_name} carries no YANG "
                "tag/namespace metadata; model_dump_instances() is a NETCONF "
                "data-model API"
            )
        field_module = NAMESPACE_MODULES.get(ns)
        if field_module is None:
            raise ValueError(
                f"no module name is known for namespace {ns!r} "
                f"({type(model).__name__}.{field_name}); cannot build a "
                "module-qualified instance-identifier"
            )
        is_config = extra.get("is_config", True) is not False
        # RFC 7950 Sec 7.21.1: a config false node has no config true
        # descendants, so content=config can drop the whole subtree. The
        # reverse is not true (a config true container may hold state leaves),
        # so content=nonconfig still walks into it.
        if content == "config" and not is_config:
            continue
        if exclude_unset and field_name not in model.model_fields_set:
            continue
        value = getattr(model, field_name)
        segment = f"{field_module}:{tag}" if field_module != module else tag
        child_path = f"{path}/{segment}"
        if isinstance(value, NetconfXmlModel):
            _collect_instances(
                value,
                child_path,
                _module_name_for_model(type(value)),
                out,
                content=content,
                exclude_none=exclude_none,
                exclude_unset=exclude_unset,
            )
            continue
        if isinstance(value, list) and value and isinstance(value[0], NetconfXmlModel):
            for item in value:
                if not isinstance(item, NetconfXmlModel):
                    raise ValueError(
                        f"{type(model).__name__}.{field_name} mixes list-entry "
                        "models with scalar values"
                    )
                item_path = _list_item_path(item, path, segment)
                _collect_instances(
                    item,
                    item_path,
                    _module_name_for_model(type(item)),
                    out,
                    content=content,
                    exclude_none=exclude_none,
                    exclude_unset=exclude_unset,
                )
            continue
        if value is None:
            # A container/list field with no value has no instance. A leaf set
            # explicitly to None is only emitted when the caller asked for it.
            if exclude_none or _child_netconf_model(field_info.annotation) is not None:
                continue
            out[child_path] = None
            continue
        if not _content_matches(is_config, content):
            continue
        if isinstance(value, list):
            # RFC 7950 Sec 9.13: a leaf-list entry is addressed by its value.
            for item in value:
                out[f"{child_path}[.={_predicate_value(item)}]"] = _instance_value(
                    item
                )
        else:
            out[child_path] = _instance_value(value)


def rebuild_model_and_dependencies(cls: type[NetconfXmlModel], memo: set[type] = None) -> None:
    """Recursively and cycle-safely rebuilds deferred pydantic-xml serializers.

    This builds the WHOLE reachable graph and is therefore the expensive,
    explicit path (used by the model-gap introspection tool). Reads and writes
    use `ensure_xml_models_built` / `ensure_instance_models_built`, which build
    only what the payload or instance actually reaches; see those docstrings
    for the measured cost difference.
    """
    if memo is None:
        memo = set()
    if cls in memo:
        return
    memo.add(cls)

    # Initial resolve to populate annotations and generate initial schema metadata
    if getattr(cls, "__xml_serializer__", None) is None:
        cls.model_rebuild()

    def extract_models(annot: Any) -> list[type[NetconfXmlModel]]:
        if annot is None:
            return []
        origin = get_origin(annot)
        if origin in (Union, types.UnionType):
            models = []
            for arg in get_args(annot):
                models.extend(extract_models(arg))
            return models
        elif origin in (list, tuple, set, dict, Annotated):
            models = []
            for arg in get_args(annot):
                models.extend(extract_models(arg))
            return models
        elif isinstance(annot, type) and issubclass(annot, NetconfXmlModel):
            return [annot]
        return []

    fields = getattr(cls, "model_fields", {})
    for field_info in fields.values():
        for nested_cls in extract_models(field_info.annotation):
            rebuild_model_and_dependencies(nested_cls, memo)

    # Final seal: lock-in serializers once child dependencies are completely built
    cls.model_rebuild()


def _nested_model_classes(annotation: Any) -> list[type]:
    """Every NetconfXmlModel subclass an annotation can bind to.

    Walks unions, Annotated and list/tuple/set/dict arguments, so a union of
    models returns every member (pydantic-xml builds one serializer per
    member).
    """
    found: list[type] = []

    def walk(annot: Any) -> None:
        if isinstance(annot, type):
            if issubclass(annot, NetconfXmlModel) and annot not in found:
                found.append(annot)
            return
        for arg in get_args(annot):
            walk(arg)

    walk(annotation)
    return found


#: (tag, ns) -> model classes per model class, computed once (`model_fields`
#: never change after class creation). Without it every element of a list entry
#: would re-walk the parent's annotations.
_XML_CHILD_MODELS: dict[type, dict[tuple[str | None, str | None], tuple[type, ...]]] = {}


def _xml_child_models(model_cls: type) -> dict[tuple[str | None, str | None], tuple[type, ...]]:
    """Map (tag, ns) -> the model classes that element binds to, for one model.

    Data nodes carry `tag`/`ns` in `json_schema_extra`, and there `ns` is
    authoritative: an augment keeps the AUGMENTING module's namespace on the
    wire (RFC 7950 Sec 7.17), which is *not* the child class's own default
    nsmap (measured: 43 such fields on the G30 tree, e.g.
    `SubcardPortSubportItem.partner_port`). RPC envelope fields
    (`element(tag="input")`) carry no `json_schema_extra` at all, so they fall
    back to the child class's own tag and default namespace -- which is what
    pydantic-xml binds. Missing an untagged field here is not cosmetic: the
    child would stay unbuilt and the RPC reply would fail with
    "model ... is partially initialized".
    """
    cached = _XML_CHILD_MODELS.get(model_cls)
    if cached is not None:
        return cached
    children: dict[tuple[str | None, str | None], list[type]] = {}
    for field_info in model_cls.model_fields.values():
        extra = field_info.json_schema_extra or {}
        tag = extra.get("tag")
        ns = extra.get("ns")
        for child_cls in _nested_model_classes(field_info.annotation):
            if child_cls is model_cls:
                continue
            child_tag, child_ns = tag, ns
            if child_tag is None:
                child_tag = child_cls.__xml_tag__
                child_ns = (child_cls.__xml_nsmap__ or {}).get("")
            bucket = children.setdefault((child_tag, child_ns), [])
            if child_cls not in bucket:
                bucket.append(child_cls)
    cached = {key: tuple(value) for key, value in children.items()}
    _XML_CHILD_MODELS[model_cls] = cached
    return cached


def _ensure_direct_children_built(model_cls: type, built: set[type]) -> None:
    """Build one model plus every model class its own fields reference.

    pydantic-xml asserts a field's model serializer exists before it walks a
    parent's fields -- `ModelDeserializer.deserialize` for deserialization and
    `ModelSerializer.serialize` for serialization (both in
    `pydantic_xml/serializers/factories/model.py`; `:450` and `:417` in
    pydantic-xml 2.22.0) -- and it does so even when the element or value is
    absent. Those direct children are therefore mandatory; anything deeper is
    only reachable through a present element/value, so it is built there
    instead.
    """
    if model_cls not in built:
        built.add(model_cls)
        if model_cls.__xml_serializer__ is None:
            model_cls.model_rebuild()
    for classes in _xml_child_models(model_cls).values():
        for child_cls in classes:
            if child_cls in built:
                continue
            built.add(child_cls)
            if child_cls.__xml_serializer__ is None:
                child_cls.model_rebuild()


def ensure_xml_models_built(
    element: etree._Element,
    model_cls: type,
    built: set[type] | None = None,
) -> None:
    """Build exactly the model classes this payload instantiates.

    The previous implementation rebuilt the whole reachable graph
    (`rebuild_model_and_dependencies`) before parsing anything. Measured on the
    G30 tree: 1355 model classes / ~30k fields, 34s cold -- while the reply
    itself arrived in 0.1s. Cost is unavoidable per class (pydantic schema
    generation), so the fix is to stop paying it for classes the reply cannot
    reach: descend only into elements that are actually present.

    Same payload on the same tree: 10 classes / ~4s for a container read, and
    the full graph is only built by a full-tree read that actually carries it.
    """
    if built is None:
        built = set()
    _ensure_direct_children_built(model_cls, built)
    children = _xml_child_models(model_cls)
    for child_element in element:
        qname = etree.QName(child_element)
        for (tag, ns), classes in children.items():
            if qname.localname != tag or (ns and qname.namespace != ns):
                continue
            for child_cls in classes:
                ensure_xml_models_built(child_element, child_cls, built)


def ensure_instance_models_built(model: Any, built: set[type] | None = None) -> None:
    """Serialization twin of `ensure_xml_models_built`, driven by the instance.

    `ModelSerializer.serialize` asserts the same direct-child invariant as the
    deserializer, so a write payload needs the classes its populated fields
    reach -- not the whole graph.
    """
    if built is None:
        built = set()
    model_cls = type(model)
    _ensure_direct_children_built(model_cls, built)
    for name, field_info in model_cls.model_fields.items():
        value = getattr(model, name, None)
        if value is None or not _nested_model_classes(field_info.annotation):
            continue
        values = value if isinstance(value, (list, tuple, set)) else [value]
        for item in values:
            if isinstance(item, NetconfXmlModel):
                ensure_instance_models_built(item, built)

def _extract_child_model(annot: Any) -> type | None:
    """Unwrap Optional/list/Annotated aliases to the nested model class."""
    if annot is None:
        return None
    origin = get_origin(annot)
    if origin in (Union, types.UnionType):
        for arg in get_args(annot):
            found = _extract_child_model(arg)
            if found is not None:
                return found
    elif origin in (list, tuple, set, dict, Annotated):
        for arg in get_args(annot):
            found = _extract_child_model(arg)
            if found is not None:
                return found
    elif isinstance(annot, type) and issubclass(annot, BaseModel):
        return annot
    return None

def _has_content(value: Any) -> bool:
    """True when a pruned subtree still holds at least one live value."""
    if isinstance(value, dict):
        return any(_has_content(v) for v in value.values())
    if isinstance(value, list):
        return any(_has_content(v) for v in value)
    return value is not None


def normalize_identityrefs(element: etree._Element, model_cls: type | None, module_namespaces: dict[str, str]) -> None:
    """Rewrite identityref values from XML prefix form to RFC 7951 Sec 6.8
    module-name form ('module:identity') using the in-scope namespaces.

    Keeps models protocol-agnostic: retrieved values match the canonical
    JSON encoding, so they round-trip unchanged through both transports.
    """
    if model_cls is None or not hasattr(model_cls, "model_fields"):
        return
    namespace_modules = {ns: name for name, ns in module_namespaces.items()}
    for field_info in model_cls.model_fields.values():
        extra = field_info.json_schema_extra or {}
        tag = extra.get("tag")
        if tag is None:
            continue
        ns = extra.get("ns")
        if extra.get("is_identityref"):
            for child in element:
                qname = etree.QName(child)
                if qname.localname != tag or (ns and qname.namespace != ns):
                    continue
                text = child.text or ""
                if ":" not in text:
                    continue
                prefix, name = text.split(":", 1)
                module = namespace_modules.get((child.nsmap or {}).get(prefix, ""))
                if module:
                    child.text = f"{module}:{name}"
            continue
        child_cls = _extract_child_model(field_info.annotation)
        if child_cls is not None and child_cls is not model_cls:
            for child in element:
                qname = etree.QName(child)
                if qname.localname == tag and (not ns or qname.namespace == ns):
                    normalize_identityrefs(child, child_cls, module_namespaces)

def _strip_nonconfig_tree(element: etree._Element, model_cls: type | None) -> None:
    """Remove `config false` subtrees in place using is_config metadata."""
    if model_cls is None or not hasattr(model_cls, "model_fields"):
        return
    for field_info in model_cls.model_fields.values():
        extra = field_info.json_schema_extra or {}
        tag = extra.get("tag")
        if tag is None:
            continue
        ns = extra.get("ns")
        # Only an explicit False means "state data, strip it". A missing or
        # None is_config means config-ness is not defined here (rpc/action/
        # notification subtrees); treating that as False deleted rpc input
        # parameters from every write payload.
        if extra.get("is_config", True) is not False:
            child_cls = _extract_child_model(field_info.annotation)
            if child_cls is not None and child_cls is not model_cls:
                for child in list(element):
                    qname = etree.QName(child)
                    if qname.localname == tag and (not ns or qname.namespace == ns):
                        _strip_nonconfig_tree(child, child_cls)
            continue
        for child in list(element):
            qname = etree.QName(child)
            if qname.localname == tag and (not ns or qname.namespace == ns):
                element.remove(child)

class NetconfBaseModel(NetconfXmlModel, nsmap={"nc": NETCONF_BASE_NS}):
    model_config = ConfigDict(extra="forbid", validate_assignment=True, defer_build=True, populate_by_name=True)
    # ns="nc" (prefix alias, not the URI): pydantic-xml resolves attr namespaces
    # through the model nsmap, and a subclass inherits this one -- pydantic-xml
    # merges rather than replaces (`__init_subclass__`: `dict(parent_nsmap,
    # **nsmap)`), so the per-module `_ModuleBase` in models.py only has to add
    # the default namespace and the import prefixes.
    nc_operation: str | None = attr(name="operation", ns="nc", default=None)

    @model_validator(mode="before")
    @classmethod
    def _accept_wire_names(cls, data: Any) -> Any:
        """Accept the YANG wire name as well as the Python field name.

        pydantic-xml binds an element to a field by its `tag`, not by the
        Python attribute name, so a NETCONF model has no `alias` and
        `model_validate` would otherwise only accept e.g. `delay_seconds`.
        The RESTCONF models carry `Field(alias="delay-seconds")` and accept
        the wire name, so a dict written for one client raised
        `extra_forbidden` on the other. Mapping the tag back here is what
        makes `update()/create()/rpc()` take the *same* dict on both
        transports (protocol parity), while `extra="forbid"` still rejects
        genuinely unknown nodes.
        """
        if not isinstance(data, dict):
            return data
        # nc_operation is an attribute, not a pydantic-xml element, and has no
        # `tag` in json_schema_extra, so name its wire form explicitly.
        by_wire = {"operation": "nc_operation"}
        for name, fi in cls.model_fields.items():
            tag = (fi.json_schema_extra or {}).get("tag")
            if tag and tag != name:
                by_wire[tag] = name
        if not (set(data) & set(by_wire)):
            return data
        return {(by_wire.get(k) or k): v for k, v in data.items()}

    def model_dump(self, *, content: Literal["config", "all", "nonconfig"] = "all", **kwargs: Any) -> dict[str, Any]:
        """Content-aware dump, mirroring YangBaseModel.model_dump (protocol parity).

        `content=` selects which datastore subtree the dump keeps -- `config`
        keeps config leaves, `nonconfig` the state ones, `all` both -- exactly
        like the RESTCONF base (RFC 8040 Sec 4.5.2 `content`, NMDA
        config-filter per RFC 8526). The XML layer already prunes retrieved
        trees (`prune_xml_to_content` in the navigator), so this is idempotent
        for models that came out of a pruned read; the override exists so a
        NETCONF caller writes the same `model_dump(content=...)` call as a
        RESTCONF one instead of hitting a pydantic `TypeError: unexpected
        keyword argument`.
        """
        kwargs.setdefault("mode", "json")
        kwargs.setdefault("by_alias", True)
        data = super().model_dump(**kwargs)
        if content == "all":
            return data
        type(self)._prune_content(data, content, by_alias=kwargs.get("by_alias", True))
        return data

    def model_dump_json(self, *, indent: int | None = None, content: Literal["config", "all", "nonconfig"] = "all", **kwargs: Any) -> str:
        """JSON mirror of model_dump. pydantic's BaseModel.model_dump_json does not route through model_dump, so the content pruning has to be applied here too."""
        # ensure_ascii belongs to the JSON encoder, not to model_dump.
        ensure_ascii = bool(kwargs.pop("ensure_ascii", False))
        data = self.model_dump(content=content, **kwargs)
        return json.dumps(data, indent=indent, ensure_ascii=ensure_ascii)

    def model_dump_instances(
        self,
        instance_path: str,
        *,
        content: Literal["config", "all", "nonconfig"] = "all",
        exclude_none: bool = True,
        exclude_unset: bool = True,
    ) -> dict[str, Any]:
        """Flatten this model into ``{instance-identifier: value}``.

        ``instance_path`` is the RFC 7950 Sec 9.13 instance-identifier of THIS
        model -- typically ``navigator.instance_identifier()``. Every populated
        leaf and leaf-list entry below it becomes one entry, addressed with the
        module qualification of RFC 7951 Sec 6.11 and, for a list entry, one
        predicate per key in `key`-statement order.

        This is the comparison primitive: two models of the same subtree (a
        hand-written intent and a retrieved running config) flatten to
        dictionaries that can be diffed key by key without caring about field
        order, list order, or which optional nodes happen to be present.

        ``content`` matches ``model_dump``'s config-filter semantics: ``config``
        drops state leaves (and config-false subtrees, which cannot contain
        config leaves -- RFC 7950 Sec 7.21.1), ``nonconfig`` drops config leaves
        while still walking through their containers, ``all`` keeps both.
        ``exclude_unset`` and ``exclude_none`` decide whether a field the model
        never populated contributes an entry; their defaults keep only the
        values actually present in the payload.
        """
        if not instance_path or not instance_path.startswith("/"):
            raise ValueError(
                "instance_path must be an absolute instance-identifier such as "
                "'/module:container' (RFC 7950 Sec 9.13); pass the navigator's "
                "instance_identifier()"
            )
        path = instance_path.rstrip("/")
        if not path:
            raise ValueError(
                "the datastore root is not an instance node, so its contents "
                "cannot be addressed relative to it (RFC 7950 Sec 9.13)"
            )
        if content not in ("config", "all", "nonconfig"):
            raise ValueError(
                f"content must be 'config', 'all' or 'nonconfig', not {content!r}"
            )
        out: dict[str, Any] = {}
        _collect_instances(
            self,
            path,
            _module_name_for_model(type(self)),
            out,
            content=content,
            exclude_none=exclude_none,
            exclude_unset=exclude_unset,
        )
        return out

    def model_dump_instances_json(
        self,
        instance_path: str,
        *,
        indent: int | None = None,
        sort_keys: bool = True,
        ensure_ascii: bool = False,
        **kwargs: Any,
    ) -> str:
        """JSON mirror of ``model_dump_instances``.

        Keys are sorted by default: an instance-identifier map is a comparison
        artifact, and stable key order makes a textual diff meaningful. Pass
        ``sort_keys=False`` to keep the model's traversal order.
        """
        return json.dumps(
            self.model_dump_instances(instance_path, **kwargs),
            indent=indent,
            sort_keys=sort_keys,
            ensure_ascii=ensure_ascii,
        )

    @classmethod
    def _prune_content(cls, data: Any, content: str, by_alias: bool) -> None:
        """Drop in place every subtree holding no node that matches content.

        Bottom-up mirror of YangBaseModel._prune_content (RESTCONF): children
        are pruned first, then a mismatching node is dropped only when nothing
        matchable remains below it, so ancestor shells survive when a matchable
        descendant exists (RFC 8040 Sec 4.5.2 hierarchy preservation; NMDA
        config-filter per RFC 8526 Sec 3.1.2).
        """
        if not isinstance(data, dict):
            return
        for field_name, field_info in cls.model_fields.items():
            alias = field_info.alias
            key = alias if by_alias and alias and alias in data else field_name
            if key not in data:
                continue
            # nc_operation is the nc:operation *attribute*, not a data node
            # (RFC 6241 Sec 7.2 rides it on edit payloads): it is never part of
            # the resource contents, at any depth, so a content-scoped dump
            # must not surface it.
            if field_name == "nc_operation":
                data.pop(key, None)
                continue
            extra = field_info.json_schema_extra
            # Only an explicit False means state data; a missing/None is_config
            # means config-ness is not defined here (rpc/action/notification).
            is_config = True
            if isinstance(extra, dict) and extra.get("is_config") is False:
                is_config = False
            match = (content == "config") == bool(is_config)
            value = data[key]
            sub = _child_netconf_model(field_info.annotation)
            if sub is not None:
                if isinstance(value, dict):
                    sub._prune_content(value, content, by_alias)
                elif isinstance(value, list):
                    for item in value:
                        sub._prune_content(item, content, by_alias)
            # A mismatching leaf/leaf-list always drops. A mismatching
            # container/list keeps an ancestor shell only when a matchable
            # descendant remains, so state under config (or vice versa) never
            # leaks but hierarchy is preserved.
            keep_shell = sub is not None and isinstance(value, (dict, list)) and _has_content(value)
            if not match and not keep_shell:
                del data[key]

    def to_xml_payload(self, **kwargs: Any) -> str | bytes:
        """Serializes config nodes only (RFC 6241 edit-config/edit-data).

        pydantic-xml to_xml() has no field-exclusion support, so serialize
        with exclude_unset and strip operational (`config false`) subtrees
        afterwards using the is_config model metadata.
        """
        allowed = {
            k: v
            for k, v in kwargs.items()
            if k in ("skip_empty", "exclude_none", "exclude_unset")
        }
        allowed.setdefault("exclude_unset", True)
        xml = self.to_xml(**allowed)
        root = etree.fromstring(xml if isinstance(xml, bytes) else xml.encode())
        _strip_nonconfig_tree(root, type(self))
        # Prune namespace declarations nothing in the tree uses. Every model
        # re-declares the whole module nsmap on its root, so a bare payload
        # carries dozens of redundant xmlns -- harmless alone, but when the
        # navigator grafts this element under ancestor wrappers, a redundant
        # default declaration shadows the inherited one and the root tag
        # serializes into the WRONG namespace (measured: {boot}autoboot sent
        # as {system}autoboot, device answers unknown-namespace). Prefixes
        # that appear only in text (identityref/module-name values, RFC 7951
        # Sec 6.8) are invisible to the cleanup pass, so keep every declared
        # prefix the text still references -- dropping one puts an undeclared
        # prefix on the wire (RFC 7950 Sec 9.10.3).
        declared = set(root.nsmap or {})
        text_used = set()
        for el in root.iter():
            if isinstance(el.tag, str) and el.text and ":" in el.text:
                text_used.add(el.text.split(":", 1)[0])
        etree.cleanup_namespaces(root, keep_ns_prefixes=sorted(text_used & declared))
        return etree.tostring(root)

def _child_netconf_model(annotation: Any) -> type[NetconfBaseModel] | None:
    """Unwrap Annotated/Optional/Union/list to find a single NetconfBaseModel subclass.

    Returns None when ambiguous (union of several models) or absent, in which
    case the subtree is left unpruned rather than pruned wrongly.
    """
    from typing import get_args

    found: set[type[NetconfBaseModel]] = set()

    def walk(ann: Any) -> None:
        if isinstance(ann, type):
            if issubclass(ann, NetconfBaseModel):
                found.add(ann)
        for arg in get_args(ann):
            walk(arg)

    walk(annotation)
    if len(found) == 1:
        return found.pop()
    return None


Decimal64 = Decimal
Uint64 = int
Int64 = int


def _empty_to_str(v: Any) -> Any:
    """YANG `empty` is an element with no content (RFC 7950 Sec 9.11)."""
    if v is None:
        return None
    if v is True or v is False or v == "":
        return ""
    return str(v)


# A Python bool serialized to "<flag>false</flag>", which a conformant server
# rejects for an `empty` leaf; a str renders as "<flag></flag>", which XML
# treats identically to "<flag/>".
Empty = Annotated[str | None, BeforeValidator(_empty_to_str)]

def check_pattern(pattern: str, v: str) -> str:
    if isinstance(v, str) and not re.match(pattern, v): raise ValueError(f'Value does not match pattern: {pattern}')
    return v