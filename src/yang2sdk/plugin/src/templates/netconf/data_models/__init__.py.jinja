{% set seen_data_ns = [] %}
class Data(NetconfXmlModel, tag='data', nsmap={'': 'urn:ietf:params:xml:ns:netconf:base:1.0'{% for prop in data_props %}{% if prop.module not in seen_data_ns %}, '{{ prop.module }}': '{{ prop.ns }}'{% set _ = seen_data_ns.append(prop.module) %}{% endif %}{% endfor %}}, ns=''):
    """Aggregate root data nodes."""
    model_config = ConfigDict(extra='forbid', validate_assignment=True, defer_build=True, populate_by_name=True)
    
    {% if not data_props %}pass{% else %}
    {% for prop in data_props %}
    {{ prop.module }}_{{ prop.field }}: '{{ module_aliases[prop.module] }}.{{ prop.cls }} | None' = element(tag='{{ prop.alias.split(":")[1] }}', ns='{{ prop.module }}', default=None, json_schema_extra={'tag': '{{ prop.alias.split(":")[1] }}', 'ns': '{{ prop.ns }}'})
    {% endfor %}

    def model_dump_instances(
        self,
        instance_path: str = "",
        *,
        content: Literal["config", "all", "nonconfig"] = "all",
        exclude_none: bool = True,
        exclude_unset: bool = True,
        exclude_defaults: bool = False,
    ) -> dict[str, Any]:
        """Flatten every populated compiled root to ``{instance-id: value}``.

        The datastore root has no instance-identifier (RFC 7950 Sec 9.13), so
        this override dumps each top-level node under its own absolute path
        instead of taking one. It is what makes ``Data.retrieve()`` usable as
        a single-line running-config snapshot.
        """
        if instance_path not in ("", "/"):
            raise ValueError(
                "Data.model_dump_instances() dumps the datastore root; pass no "
                "instance_path (use a node navigator for a subtree)"
            )
        out: dict[str, Any] = {}
        _collect_instances(
            self,
            "",
            "",
            out,
            content=content,
            exclude_none=exclude_none,
            exclude_unset=exclude_unset,
            exclude_defaults=exclude_defaults,
        )
        return out
    {% endif %}

