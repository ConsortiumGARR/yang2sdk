"""Auto-generated NETCONF pydantic-xml models"""

from typing import Annotated, Any, Literal, TypeVar
from pydantic import ConfigDict, Field, AfterValidator
from pydantic_xml import element, attr
from enum import Enum

from ._base import NetconfBaseModel, NetconfXmlModel, Decimal64, Uint64, Int64, Empty, check_pattern

{# One nsmap for the whole module, declared on an intermediate base class.

   Every model in this file comes from the same YANG module, so `namespace` and
   `imports_nsmap` are file constants -- the per-class copy this template used
   to emit was pure repetition (measured on the G30 tree: the same 25-entry map
   on 1358 classes, 1.9 MiB of a generated client's `data_models/`).

   Inheritance is enough: pydantic-xml merges a subclass nsmap into its parent's
   (`BaseXmlModel.__init_subclass__`: `dict(parent_nsmap, **nsmap)`), so a model
   class that declares none still gets `nc`, the default namespace and every
   import prefix. Verified against 11 generated clients (8.5k classes) by
   comparing `__xml_nsmap__`, the wire QName and `to_xml()` bytes before/after.

   Two bases because RPC envelopes deliberately derive from `NetconfXmlModel`
   (no `nc_operation`, no data-model validator). Names start with `_` and are
   collision-free by construction: `_to_class_name` capitalizes every word, so a
   generated model name can never begin with an underscore.

   "nc" is declared here (and inherited by every model) because
   `NetconfBaseModel.nc_operation` serializes an attribute in the NETCONF base
   namespace (RFC 6241 Sec 7.1) and resolves that prefix through the model
   nsmap. The loop skips an `nc` entry from `imports_nsmap` that binds the same
   URI -- a module importing ietf-netconf would otherwise emit the same key
   twice in one literal. The URI is compared too, so a module that aliases some
   other module as `nc` keeps the binding it had before. #}
{% macro nsmap() -%}
{"nc": "urn:ietf:params:xml:ns:netconf:base:1.0", "": "{{ module.namespace }}"{% for prefix, uri in module.imports_nsmap.items() if prefix != "nc" or uri != "urn:ietf:params:xml:ns:netconf:base:1.0" %}, "{{ prefix }}": "{{ uri }}"{% endfor %}}
{%- endmacro %}
{% set data_models = module.models | rejectattr("is_rpc_envelope") | list %}{% set rpc_models = module.models | selectattr("is_rpc_envelope") | list %}{% if data_models %}
class _ModuleBase(NetconfBaseModel, nsmap={{ nsmap() }}):
    pass
{% endif %}{% if rpc_models %}
class _ModuleRpcBase(NetconfXmlModel, nsmap={{ nsmap() }}):
    pass
{% endif %}

{% for enum in module.enums %}
class {{ enum.name }}(str, Enum):
    """{{ enum.description }}"""
    {% for val in enum.values %}
    {{ val.py_name }} = "{{ val.value }}"
    {% endfor %}

{% endfor %}
{% for model in module.models %}
class {{ model.name }}({% if model.is_rpc_envelope %}_ModuleRpcBase{% else %}_ModuleBase{% endif %}, tag="{{ model.yang_name }}", ns="{{ model.ns_alias }}"):
    """{{ model.description }}"""
    {% if not model.fields and not model.is_rpc_envelope %}
    pass
    {% else %}
    {% for field in model.fields %}
    {% for use in field.uses %}
    # Uses: {{ use }}
    {% endfor %}
    {{ field.name }}: {{ field.type_str }}{% if field.assignment %} = {{ field.assignment }}{% endif %}
    
    {% endfor %}
    {% if model.is_rpc_envelope %}
    {% if model.rpc_input_cls %}
    input: {{ model.rpc_input_cls }} | None = element(tag="input", default=None)
    {% endif %}
    {% if model.rpc_output_cls %}
    output: {{ model.rpc_output_cls }} | None = element(tag="output", default=None)
    {% endif %}
    {% if not model.rpc_input_cls and not model.rpc_output_cls %}
    pass
    {% endif %}
    model_config = ConfigDict(extra='forbid', validate_assignment=True, defer_build=True, populate_by_name=True)
    {% endif %}
    {% endif %}

{% endfor %}