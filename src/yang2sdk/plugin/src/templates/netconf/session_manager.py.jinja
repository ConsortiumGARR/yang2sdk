# RFC 6241 Sec 8.1 / RFC 8526 Sec 3.1.1 base capability URIs. A capability is
# a bare URI optionally followed by "?" parameters; a module capability is
# "<namespace>?module=<name>&..." and must never be mistaken for a protocol
# capability, hence the exact base comparison in _has_capability().
_CAP_CANDIDATE = "urn:ietf:params:netconf:capability:candidate:1.0"
_CAP_WRITABLE_RUNNING = "urn:ietf:params:netconf:capability:writable-running:1.0"
_CAP_NMDA = "urn:ietf:params:netconf:capability:nmda:1.0"
_CAP_CONFIRMED_COMMIT = "urn:ietf:params:netconf:capability:confirmed-commit:1.1"
_CAP_ROLLBACK_ON_ERROR = "urn:ietf:params:netconf:capability:rollback-on-error:1.0"
_CAP_VALIDATE_1_0 = "urn:ietf:params:netconf:capability:validate:1.0"
# RFC 6241 Sec 7.2: <test-option> MAY be sent only with :validate:1.1, and
# Sec 8.6.4.1 makes "test-only" a 1.1-only value. A device that advertises
# only 1.0 supports <validate> but not a dry run, so the two versions are
# tracked separately.
_CAP_VALIDATE_1_1 = "urn:ietf:params:netconf:capability:validate:1.1"

# Every module pyang loaded for this client: module name -> namespace, merged
# across the compiled roots. This is a COMPILE-TIME fact, not a device one, and
# two consumers need it for different reasons:
#   * identityref values are XML QNames, so a prefix MUST be declared on the
#     wire (RFC 7950 Sec 9.10.3) -- see `module_namespaces` in __init__;
#   * an instance-identifier names each node by its DEFINING module
#     (RFC 7951 Sec 6.11), which is a schema property, so the navigators invert
#     this map rather than asking the peer's <hello>.
MODULE_NAMESPACES: dict[str, str] = {{ module_namespaces_literal }}

# --- instance-identifier parsing, surgical diff and plan --------------------
#
# The plan builder is model-free: it consumes the `{instance-identifier:
# value}` maps produced by `model_dump_instances()` and emits one
# `<config>` for `<edit-config>` / `<edit-data>`. Paths follow RFC 7950
# Sec 9.13 and RFC 7951 Sec 6.11, so the only schema fact needed is
# module -> namespace, which is the compile-time map above.

NETCONF_NS = "urn:ietf:params:xml:ns:netconf:base:1.0"
_MISSING = object()


def split_instance_path(path: str) -> list[str]:
    """Split on ``/`` outside RFC 7950 Sec 14 quoted strings.

    A predicate value is a quoted string with no escape mechanism, so a value
    may legally contain ``/``, ``[`` or ``]``. Splitting naively on ``/`` would
    turn a key like ``10.0.0.0/24`` into two segments.
    """
    if path.startswith("/"):
        path = path[1:]
    if not path:
        return []
    parts: list[str] = []
    start = 0
    quote: str | None = None
    for index, char in enumerate(path):
        if quote is not None:
            if char == quote:
                quote = None
            continue
        if char in ("'", '"'):
            quote = char
        elif char == "/":
            parts.append(path[start:index])
            start = index + 1
    if quote is not None:
        raise ValueError(f"unterminated quoted string in instance path {path!r}")
    parts.append(path[start:])
    if any(part == "" for part in parts):
        raise ValueError(f"empty segment in instance path {path!r}")
    return parts


def parse_instance_path_segment(
    segment: str,
) -> tuple[str | None, str, list[tuple[str, str]]]:
    """Parse ``module:name[key='value']...`` into its three parts."""
    bracket = segment.find("[")
    if bracket == -1:
        head, rest = segment, ""
    else:
        head, rest = segment[:bracket], segment[bracket:]
    if ":" in head:
        prefix, name = head.split(":", 1)
        if not prefix or not name or ":" in name:
            raise ValueError(f"invalid module-qualified segment {segment!r}")
    else:
        prefix, name = None, head
    if not name:
        raise ValueError(f"empty node name in segment {segment!r}")

    predicates: list[tuple[str, str]] = []
    rest = rest.lstrip()
    while rest:
        if not rest.startswith("["):
            raise ValueError(f"malformed predicate in segment {segment!r}")
        equals = rest.find("=", 1)
        if equals == -1:
            raise ValueError(f"predicate without '=' in segment {segment!r}")
        key = rest[1:equals].strip()
        if not key:
            raise ValueError(f"predicate without a name in segment {segment!r}")
        index = equals + 1
        while index < len(rest) and rest[index].isspace():
            index += 1
        if index >= len(rest) or rest[index] not in ("'", '"'):
            raise ValueError(f"predicate value is not quoted in segment {segment!r}")
        quote = rest[index]
        index += 1
        value_start = index
        while index < len(rest) and rest[index] != quote:
            index += 1
        if index >= len(rest):
            raise ValueError(f"unterminated predicate value in segment {segment!r}")
        value = rest[value_start:index]
        index += 1
        while index < len(rest) and rest[index].isspace():
            index += 1
        if index >= len(rest) or rest[index] != "]":
            raise ValueError(f"predicate is not closed in segment {segment!r}")
        predicates.append((key, value))
        rest = rest[index + 1:].lstrip()
    return prefix, name, predicates


def parse_instance_path(
    path: str, module_namespaces: Mapping[str, str]
) -> list[tuple[str, str, dict[str, str]]]:
    """Turn an absolute instance-identifier into ``(namespace, tag, keys)``.

    A bare segment inherits the nearest preceding module (RFC 7951 Sec 6.11),
    so ``/ne:ne/shelf`` names ``ne:shelf``. The leftmost segment must be
    module-qualified; without it the path is ambiguous.
    """
    if not path.startswith("/"):
        raise ValueError(
            f"instance path {path!r} must be absolute (RFC 7950 Sec 9.13)"
        )
    segments: list[tuple[str, str, dict[str, str]]] = []
    previous: str | None = None
    for raw in split_instance_path(path):
        prefix, name, predicates = parse_instance_path_segment(raw)
        module = prefix or previous
        if module is None:
            raise ValueError(
                f"instance path {path!r} must module-qualify its leftmost node "
                "(RFC 7951 Sec 6.11)"
            )
        namespace = module_namespaces.get(module)
        if namespace is None:
            raise ValueError(
                f"instance path {path!r} names module {module!r}, which this "
                "client was not compiled for"
            )
        segments.append((namespace, name, dict(predicates)))
        previous = module
    return segments


def _is_leaf_list_entry(path: str) -> bool:
    """True when the last segment is a ``[.='value']`` leaf-list entry."""
    _, _, predicates = parse_instance_path_segment(path.rsplit("/", 1)[-1])
    return len(predicates) == 1 and predicates[0][0] == "."


def _leaf_list_base(path: str) -> str:
    head, _, last = path.rpartition("/")
    bracket = last.find("[")
    node = last[:bracket] if bracket != -1 else last
    return f"{head}/{node}" if head else node


def _leaf_list_sequences(mapping: Mapping[str, Any]) -> dict[str, list[Any]]:
    sequences: dict[str, list[Any]] = {}
    for path, value in mapping.items():
        if _is_leaf_list_entry(path):
            sequences.setdefault(_leaf_list_base(path), []).append(value)
    return sequences


@dataclass(frozen=True)
class Removal:
    """One collapsed ``-`` entry.

    ``kind`` is ``"leaf"``, ``"container"`` or ``"list-entry"``, so a caller
    can tell before planning whether one leaf or a whole subtree will be
    deleted. ``leaves`` keeps the leaf-level ``-`` lines for display.
    """

    path: str
    kind: str
    leaves: dict[str, Any] = field(default_factory=dict)


class InstanceDiff(dict):
    """``{"+": ..., "~": ..., "-": ...}`` with attribute aliases."""

    def __init__(
        self,
        added: dict[str, Any],
        changed: dict[str, Any],
        removed: dict[str, Removal],
    ) -> None:
        super().__init__({"+": added, "~": changed, "-": removed})

    @property
    def added(self) -> dict[str, Any]:
        return self["+"]

    @property
    def changed(self) -> dict[str, Any]:
        return self["~"]

    @property
    def removed(self) -> dict[str, Removal]:
        return self["-"]


def _collapse_removals(
    removed: Mapping[str, Any], intended_keys: Mapping[str, Any] | list[str]
) -> dict[str, Removal]:
    """Collapse leaf-level removals to the highest wholly-removed node.

    A key leaf cannot be deleted (RFC 7950 Sec 7.8.2), and deleting a
    container that still has an intended child would delete that child. So
    walk up while the parent has no intended descendant, and remove there.
    """
    intended = list(intended_keys)
    groups: dict[str, dict[str, Any]] = {}
    for path, value in removed.items():
        ancestor = path
        while True:
            parent = ancestor.rsplit("/", 1)[0]
            if not parent:
                break
            if any(k == parent or k.startswith(parent + "/") for k in intended):
                break
            ancestor = parent
        groups.setdefault(ancestor, {})[path] = value

    collapsed: dict[str, Removal] = {}
    for ancestor, leaves in groups.items():
        last = ancestor.rsplit("/", 1)[-1]
        if ancestor in leaves:
            kind = "leaf"
        elif "[" in last:
            kind = "list-entry"
        else:
            kind = "container"
        collapsed[ancestor] = Removal(path=ancestor, kind=kind, leaves=leaves)
    return collapsed


def diff_instances(
    running_map: Mapping[str, Any], intended_map: Mapping[str, Any]
) -> InstanceDiff:
    """Classify two ``model_dump_instances()`` maps into ``{+, ~, -}``.

    Leaf-lists are compared as ordered sequences: any difference (reorder,
    add, remove) is one ``~`` keyed by the leaf-list node, carrying
    ``(running_sequence, intended_sequence)``. ``-`` is already collapsed, so
    ``plan()`` and ``reconcile()`` need only the diff.
    """
    running_ll = _leaf_list_sequences(running_map)
    intended_ll = _leaf_list_sequences(intended_map)
    changed: dict[str, Any] = {}
    for base in dict.fromkeys([*running_ll, *intended_ll]):
        running_sequence = running_ll.get(base, [])
        intended_sequence = intended_ll.get(base, [])
        if running_sequence != intended_sequence:
            changed[base] = (running_sequence, intended_sequence)

    added: dict[str, Any] = {}
    removed: dict[str, Any] = {}
    for path, value in intended_map.items():
        if _is_leaf_list_entry(path):
            continue
        if path not in running_map:
            added[path] = value
        elif running_map[path] != value:
            changed[path] = (running_map[path], value)
    for path, value in running_map.items():
        if _is_leaf_list_entry(path):
            continue
        if path not in intended_map:
            removed[path] = value

    return InstanceDiff(added, changed, _collapse_removals(removed, intended_map))


@dataclass
class PlanResult:
    """Outcome of ``plan()``: the message, the device verdict, what ran."""

    xml: str
    ok: bool | None
    errors: list[str] = field(default_factory=list)
    validated: str = "none"


def _lexical(value: Any) -> str:
    """YANG lexical form for an XML text node (RFC 7950 Sec 9)."""
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, Enum):
        return str(value.value)
    if value is None:
        raise ValueError("a plan value cannot be None")
    return str(value)


def _path_key(segment: tuple[str, str, dict[str, str]]) -> tuple[str, str, tuple]:
    namespace, tag, keys = segment
    return (namespace, tag, tuple(keys.items()))


def _insert(
    tree: dict,
    segments: list[tuple[str, str, dict[str, str]]],
    *,
    value: Any = _MISSING,
    operation: str | None = None,
    leaf_list: list[tuple[str | None, Any]] | None = None,
) -> None:
    node_map = tree
    node: dict | None = None
    for segment in segments:
        key = _path_key(segment)
        if key not in node_map:
            node_map[key] = {
                "segment": segment,
                "children": {},
                "value": _MISSING,
                "operation": None,
                "leaf_list": None,
            }
        node = node_map[key]
        node_map = node["children"]
    if node is None:
        raise ValueError("an edit path needs at least one segment")
    if value is not _MISSING:
        node["value"] = value
    if operation is not None:
        node["operation"] = operation
    if leaf_list is not None:
        node["leaf_list"] = leaf_list


def _render(node_map: dict, parent: etree._Element) -> None:
    for node in node_map.values():
        namespace, tag, keys = node["segment"]
        if node["leaf_list"] is not None:
            # A leaf-list has no wrapper element; its entries are repeated
            # siblings (RFC 7950 Sec 7.7). Remove old values, then merge the
            # intended ones in order.
            for operation, value in node["leaf_list"]:
                element = etree.SubElement(parent, "{" + namespace + "}" + tag)
                if operation:
                    element.set("{" + NETCONF_NS + "}operation", operation)
                element.text = _lexical(value)
            continue

        element = etree.Element(
            "{" + namespace + "}" + tag, nsmap={None: namespace}
        )
        if node["operation"]:
            element.set("{" + NETCONF_NS + "}operation", node["operation"])
        for key, key_value in keys.items():
            key_element = etree.SubElement(element, "{" + namespace + "}" + key)
            key_element.text = key_value
        if node["value"] is not _MISSING:
            element.text = _lexical(node["value"])
        _render(node["children"], element)
        parent.append(element)


def build_config(
    diff: Mapping[str, Any], module_namespaces: Mapping[str, str]
) -> etree._Element:
    """Build one ``<config>`` from ``{+, ~, -}``: the surgical edit body."""
    tree: dict = {}
    for path, value in diff["+"].items():
        _insert(tree, parse_instance_path(path, module_namespaces), value=value)

    for path, pair in diff["~"].items():
        old, new = pair
        if isinstance(old, (list, tuple)) and isinstance(new, (list, tuple)):
            entries: list[tuple[str | None, Any]] = [
                ("remove", item) for item in old
            ]
            entries.extend((None, item) for item in new)
            _insert(
                tree,
                parse_instance_path(path, module_namespaces),
                leaf_list=entries,
            )
        else:
            _insert(tree, parse_instance_path(path, module_namespaces), value=new)

    for removal in diff["-"].values():
        _insert(
            tree,
            parse_instance_path(removal.path, module_namespaces),
            operation="remove",
        )

    root = etree.Element("{" + NETCONF_NS + "}config", nsmap={None: NETCONF_NS})
    _render(tree, root)
    return root


def _c14n(element: etree._Element | None) -> bytes:
    if element is None:
        return b""
    return etree.tostring(element, method="c14n")


# SSH public-key authentication. `DEVICE_SSH_KEY` points at the private key
# (or at its OpenSSH certificate, which paramiko resolves to the adjacent
# private key -- see _resolve_key_files); `DEVICE_SSH_KEY_PASSPHRASE` unlocks
# an encrypted key. Both are optional: the credential contract still fails
# closed, requiring a password or a key before any transport work.
_ENV_SSH_KEY = "DEVICE_SSH_KEY"
_ENV_SSH_KEY_PASSPHRASE = "DEVICE_SSH_KEY_PASSPHRASE"


def _resolve_key_files(key_filename):
    """Normalize and validate key/certificate paths for ncclient.

    Accepts one path or a sequence. OpenSSH certificate authentication uses
    the conventional `<private-key>-cert.pub` filename: paramiko's
    `PKey.from_path` strips that suffix to load the private key and then
    attaches the certificate, so passing either member of the pair works. A
    certificate path therefore requires its adjacent private key. Paths are
    expanded (~) but never read or parsed here -- key material stays out of
    this module.
    """
    if key_filename is None:
        return None
    if isinstance(key_filename, (str, os.PathLike)):
        entries = [key_filename]
    else:
        try:
            entries = list(key_filename)
        except TypeError:
            raise ValueError(
                "key_filename must be a path or a sequence of paths, "
                f"not {type(key_filename).__name__}"
            ) from None
    if not entries:
        raise ValueError("key_filename was given but contains no paths")
    resolved = []
    for entry in entries:
        try:
            path = os.path.expanduser(os.fspath(entry))
        except TypeError:
            raise ValueError(
                "key_filename entries must be str or os.PathLike, "
                f"not {type(entry).__name__}"
            ) from None
        if not os.path.isfile(path):
            raise ValueError(f"SSH key/certificate file not found: {path!r}")
        # paramiko resolves `<key>-cert.pub` by loading the adjacent private
        # key and attaching the certificate. Agent and ~/.ssh discovery are
        # disabled for explicit paths, so a certificate without that private
        # key can never authenticate; reject it here instead of failing later
        # with an opaque transport error.
        cert_suffix = "-cert.pub"
        if path.endswith(cert_suffix):
            private_key = path[: -len(cert_suffix)]
            if not os.path.isfile(private_key):
                raise ValueError(
                    f"SSH certificate {path!r} has no adjacent private key "
                    f"{private_key!r}; agent-held keys are not used when an "
                    "explicit path is given."
                )
        resolved.append(path)
    return resolved


def _is_netconf_username(value: str) -> bool:
    """True when every character matches the XML 1.0 ``Char`` production.

    RFC 6242 Sec 3 passes the SSH username to NETCONF unchanged and requires
    an invalid name to be rejected; RFC 6241 Sec 2.2 defines the username as a
    string of XML ``Char`` characters. Validate client-side so a bad name
    fails before any transport work.
    """
    for char in value:
        code = ord(char)
        if (
            code in (0x09, 0x0A, 0x0D)
            or 0x20 <= code <= 0xD7FF
            or 0xE000 <= code <= 0xFFFD
            or 0x10000 <= code <= 0x10FFFF
        ):
            continue
        return False
    return True


def _has_capability(capabilities, uri: str) -> bool:
    """True when `uri` is advertised as a base capability (exact match)."""
    return any(cap.split("?", 1)[0].strip().lower() == uri for cap in capabilities)


def validate_depth(depth: int | str) -> int | None:
    """Normalize a caller's `depth` to a positive int, or None for unbounded.

    RFC 8040 Sec 4.8.2 and RFC 8526 define depth as a positive integer with
    "unbounded" as the no-ceiling default. `depth=1` is valid (the target node
    alone). Reject only values that are not expressible: bool (an int
    subclass), zero, negatives, non-numeric strings, and values above the
    RFC 6241 Sec 7.7 uint16 ceiling of 65535. Validation happens before any
    transport work so a bad argument can never become an RPC.
    """
    if isinstance(depth, str) and depth.lower() == "unbounded":
        return None
    if isinstance(depth, bool) or not isinstance(depth, (int, str)):
        raise ValueError(
            "depth must be an integer in 1..65535 or 'unbounded', "
            f"not {type(depth).__name__}"
        )
    if isinstance(depth, str):
        if not depth.isdigit():
            raise ValueError(
                "depth must be an integer in 1..65535 or 'unbounded', "
                f"not {depth!r}"
            )
        value = int(depth)
    else:
        value = depth
    if value < 1 or value > 65535:
        raise ValueError(
            "depth must be an integer in 1..65535 or 'unbounded', "
            f"not {value}"
        )
    return value


def _rpcerror_attr(err, name: str) -> str:
    """Read an RPCError attribute without ever raising from the error path.

    ncclient 0.7 models these as properties over `_tag`/`_type`/`_severity`,
    which are absent when the error list holds plain strings, so `getattr`
    on the public name can itself raise AttributeError.
    """
    try:
        return str(getattr(err, name) or "")
    except Exception:  # noqa: BLE001 - error reporting must not fail
        try:
            return str(getattr(err, f"_{name}") or "")
        except Exception:  # noqa: BLE001
            return ""


def _rpcerror_text(err) -> str:
    """Best-effort plain text for an RPCError, preferring the raw XML."""
    try:
        xml = getattr(err, "xml", None)
        if xml is not None:
            return " ".join(etree.tostring(xml).decode(errors="replace").split())
    except Exception:  # noqa: BLE001 - error reporting must not fail
        pass
    return str(err)

# Substring match against lower-cased keys. `passphrase` is the important
# addition: it contains neither "password" nor "passwd", so NTP/TACACS/RADIUS
# authenticator passphrases were written to the log in cleartext whenever
# log_bodies was enabled. Bare "key" is deliberately absent -- a `key` leaf is
# far more often a primary key than a secret.
_SENSITIVE_KEYS = (
    "password", "passwd", "passphrase", "secret", "token", "auth", "community",
    "private-key", "privatekey", "psk", "pre-shared", "preshared", "credential",
    "credentials", "md5", "username",
)


def _redact(obj: Any, _depth: int = 0) -> Any:
    """Redact sensitive values and truncate payloads for safe logging."""
    if _depth > 4:
        return "...[truncated depth]"
    if isinstance(obj, dict):
        out: dict[Any, Any] = {}
        for k, v in obj.items():
            if isinstance(k, str) and any(s in k.lower() for s in _SENSITIVE_KEYS):
                out[k] = "***redacted***"
            else:
                out[k] = _redact(v, _depth + 1)
        return out
    if isinstance(obj, (list, tuple)):
        return [_redact(v, _depth + 1) for v in obj][:50]
    if isinstance(obj, str) and len(obj) > 2000:
        return obj[:2000] + f"...[truncated {len(obj) - 2000} chars]"
    if isinstance(obj, bytes) and len(obj) > 2000:
        return obj[:2000] + f"...[truncated {len(obj) - 2000} bytes]".encode()
    return obj


# Cap for a single logged RPC request/reply. Raw protocol XML is what makes a
# DEBUG log worth reading, but an unbounded full-datastore dump can flood the
# log pipeline, so over-long bodies are cut with a marker (same style as
# _redact's own truncation). INFO lines never carry bodies -- only this DEBUG
# path does.
_MAX_RPC_LOG_CHARS = 65536


def _redact_xml(element: etree._Element) -> str:
    """Serialize `element` with sensitive leaf values redacted.

    Name-based, sharing `_SENSITIVE_KEYS` with the dict redactor: any element
    whose local tag name contains a sensitive substring has its text replaced
    and its children dropped (a `<private-key>` subtree nests secrets).
    Attributes are left intact -- `message-id` correlation depends on them.
    Operates on a deepcopy and never raises: the logging path must neither
    mutate what is sent nor mask a device error with its own traceback.
    """
    try:
        scrubbed = copy.deepcopy(element)
        for el in scrubbed.iter():
            if not isinstance(el.tag, str):
                continue
            local = el.tag.rsplit("}", 1)[-1]
            if any(s in local.lower() for s in _SENSITIVE_KEYS):
                el.text = "***redacted***"
                del el[:]
        text = etree.tostring(scrubbed, encoding="unicode")
    except Exception:  # noqa: BLE001 - logging must never fail the RPC
        return "...[unserializable rpc, not logged]"
    if len(text) > _MAX_RPC_LOG_CHARS:
        text = (
            text[:_MAX_RPC_LOG_CHARS]
            + f"...[truncated {len(text) - _MAX_RPC_LOG_CHARS} chars]"
        )
    return text


def _request_wire(func: Any, args: tuple, kwargs: dict) -> str:
    """Best-effort request text for the DEBUG line. Never raises.

    `dispatch(rpc)` calls carry the rpc element in `args[0]`. Every other
    operation's envelope is built inside ncclient, so those log the operation
    name with redacted kwargs instead -- the subtree filter, when present, is
    serialized through `_redact_xml`. That is the complete request semantics;
    the envelope bytes are ncclient's, not ours, and this does not pretend
    otherwise.
    """
    try:
        if args and isinstance(args[0], etree._Element):
            return _redact_xml(args[0])
        parts: dict[str, Any] = {}
        for key, value in kwargs.items():
            parts[key] = _redact_xml(value) if isinstance(value, etree._Element) else value
        return f"{getattr(func, '__name__', 'rpc')}({_redact(parts)})"
    except Exception:  # noqa: BLE001 - logging must never fail the RPC
        return "...[unserializable request, not logged]"


def _reply_wire(reply: Any) -> tuple[str, int]:
    """(redacted reply text, raw wire size in bytes) for the DEBUG line."""
    try:
        root = _reply_root(reply)
        if root is None:
            return "...[unparseable reply, not logged]", 0
        size = len(etree.tostring(root))
        return _redact_xml(root), size
    except Exception:  # noqa: BLE001 - logging must never fail the RPC
        return "...[unserializable reply, not logged]", 0


def bind_module_prefixes(element: etree._Element, module_namespaces: dict[str, str]) -> etree._Element:
    """Declare xmlns for module-name prefixes used in identityref/instance-identifier values.

    RFC 7951 Sec 6.8/6.11 encode those values as 'module-name:identity-name'.
    XML requires the prefix to be bound (RFC 7950 Sec 9.10.3). Module names
    are valid XML NCNames, so the module name itself is used as the prefix.
    """
    used: dict[str, str] = {}
    for el in element.iter():
        if el.text and ":" in el.text:
            prefix = el.text.split(":", 1)[0]
            if prefix in module_namespaces and prefix not in (el.nsmap or {}):
                used[prefix] = module_namespaces[prefix]
    if used:
        # keep_ns_prefixes: the prefixes only appear in text, which the
        # cleanup pass would otherwise drop as "unused" declarations.
        etree.cleanup_namespaces(element, top_nsmap=used, keep_ns_prefixes=list(used))
    return element


def _reply_root(reply: Any) -> etree._Element | None:
    """Return the <rpc-reply> element across ncclient versions.

    ncclient <=0.6 exposed ``reply.ele``; ncclient 0.7 removed it from the
    base ``RPCReply`` (only ``GetReply`` keeps ``data_ele``). The raw
    ``reply.xml`` string is stable across versions, so lxml-parse it to
    guarantee an ``lxml`` element for downstream ``find``/``tostring``.
    """
    ele = getattr(reply, "ele", None)
    if ele is not None:
        return ele
    raw = getattr(reply, "xml", None)
    if raw is not None:
        if isinstance(raw, str):
            raw = raw.encode()
        try:
            return etree.fromstring(raw)
        except Exception:
            log.debug("Failed to parse NETCONF reply xml", exc_info=True)
    root = getattr(reply, "_root", None)
    if root is not None:
        try:
            reply.parse()
        except Exception:
            log.debug("Failed to parse NETCONF reply root", exc_info=True)
        root = getattr(reply, "_root", None)
        if root is not None and isinstance(root, etree._Element):
            return root
    return None

class NetconfClient:
    """Production-ready NETCONF API client wrapping ncclient.

    Swappable with RestconfClient: core kwargs (loopback_ip, management_ip,
    port, username, password, verify, log_bodies, timeout) share names and
    secure defaults; protocol extras live in **kwargs (auto_commit here,
    scheme on RESTCONF).

    NETCONF also accepts SSH public-key authentication: pass `key_filename`
    (one path or a sequence) instead of `password`, with `passphrase` for an
    encrypted key. A path to an OpenSSH certificate (`<key>-cert.pub`) works
    as well; paramiko loads the adjacent private key and attaches the
    certificate. Without an explicit path, ncclient still queries the SSH
    agent and `~/.ssh` as usual; with one, those fallbacks are disabled so an
    unauthorized key fails instead of authenticating as another identity.
    The account password is never used with a key. For an encrypted key
    ncclient puts the passphrase in its password slot and will also try it as
    a password if public-key authentication fails; use an unencrypted key if
    that fallback is unacceptable. `password` and `key_filename` are
    alternatives; supplying both is rejected.
    """

    @staticmethod
    def diff_instances(running_map, intended_map) -> InstanceDiff:
        """Classify two ``model_dump_instances()`` maps into ``{+, ~, -}``.

        The result is already collapsed, so ``plan()`` and ``reconcile()``
        need only the diff: no running or intended map is required.
        """
        return diff_instances(running_map, intended_map)

    def __init__(self, loopback_ip: str | None = None, management_ip: str | None = None, port: int = 830, username: str | None = None, password: str | None = None, verify: bool = True, timeout: int = 60, auto_commit: bool = False, log_bodies: bool = False, key_filename: str | os.PathLike[str] | list[str | os.PathLike[str]] | tuple[str | os.PathLike[str], ...] | None = None, passphrase: str | None = None, **kwargs):
        # Back-compat alias: older generated code / call sites used
        # hostkey_verify explicitly. `verify` wins when both are given.
        if "hostkey_verify" in kwargs:
            import warnings

            alias_val = kwargs.pop("hostkey_verify")
            warnings.warn("hostkey_verify is deprecated; use verify", DeprecationWarning, stacklevel=2)
            if verify is True and alias_val is False:
                verify = False
        if "scheme" in kwargs:
            # Swallow RESTCONF-only kwarg for swap parity.
            log.debug("Ignoring protocol-specific kwarg for NETCONF: scheme")
            kwargs.pop("scheme")
        self.host = loopback_ip or management_ip
        self.port = port
        # Same resolution order and same fail-closed rule as the RESTCONF
        # client: caller args, else DEVICE_USER / DEVICE_PASS -- the names the
        # rest of this project already reads, so one `.env` serves the
        # downloader, the tester and both clients. NETCONF used to keep None
        # here and hand it straight to manager.connect(), so a client built
        # with no credentials anywhere attempted an unauthenticated SSH
        # session and failed later with an opaque transport error. Raising
        # before the connect keeps the two protocols symmetrical and fails
        # closed.
        #
        # SSH public-key authentication relaxes only the *password* half of
        # that rule: a key is a credential too, so `password` and
        # `key_filename` are alternatives, not both required. The username is
        # still mandatory (the peer needs an identity to authorize).
        self.username = username or os.environ.get("DEVICE_USER")
        if self.username and not _is_netconf_username(self.username):
            raise ValueError(
                "NETCONF username must match the XML Char production "
                "(RFC 6241 Sec 2.2, RFC 6242 Sec 3)."
            )
        # Resolve credentials by SOURCE, not field by field. An explicit
        # password must not be silently overridden by DEVICE_SSH_KEY, and an
        # explicit key must not inherit an unrelated environment passphrase.
        # The rule:
        #   * both explicit      -> reject as ambiguous;
        #   * explicit password  -> use it, ignore the environment key pair;
        #   * explicit key       -> use it, ignore DEVICE_PASS and only take a
        #                           passphrase from the explicit argument;
        #   * neither explicit   -> environment, where DEVICE_SSH_KEY wins over
        #                           DEVICE_PASS with a warning.
        explicit_password = password or None
        explicit_key = key_filename or None
        explicit_passphrase = passphrase or None
        env_password = os.environ.get("DEVICE_PASS")
        env_key = os.environ.get(_ENV_SSH_KEY)
        env_passphrase = os.environ.get(_ENV_SSH_KEY_PASSPHRASE)

        if explicit_password and explicit_key:
            raise ValueError(
                "password and key_filename are alternatives; pass exactly one. "
                "Leave both unset to use DEVICE_PASS / DEVICE_SSH_KEY."
            )
        if explicit_password:
            self.password = explicit_password
            self.key_filename = None
            self.passphrase = explicit_passphrase
        elif explicit_key:
            self.password = None
            self.key_filename = explicit_key
            self.passphrase = explicit_passphrase
        elif env_key:
            self.password = None
            self.key_filename = env_key
            self.passphrase = explicit_passphrase or env_passphrase
            if env_password:
                log.warning(
                    "Both DEVICE_PASS and DEVICE_SSH_KEY are set; using the SSH "
                    "key. Pass password=... explicitly to force password auth."
                )
        else:
            self.password = env_password
            self.key_filename = None
            # No explicit source: a stray environment passphrase with no
            # environment key is still a misconfiguration, not something to
            # silently ignore (it was rejected before source-aware resolution).
            self.passphrase = explicit_passphrase or env_passphrase
        self.key_filenames = _resolve_key_files(self.key_filename)
        # ncclient's SSHSession._auth tries every explicit key, then the SSH
        # agent, then ~/.ssh/id_{rsa,ecdsa,ed25519}. With an explicit key, a
        # failed key must be a failure: falling through would silently
        # authenticate as another identity the host happens to hold. Agent and
        # default-key discovery stay available only when no path was supplied.
        allow_agent = kwargs.pop("allow_agent", True)
        look_for_keys = kwargs.pop("look_for_keys", True)
        if self.key_filenames:
            allow_agent = False
            look_for_keys = False
        if self.passphrase and not self.key_filenames:
            # ncclient has one transport `password` value and it is handed to
            # password authentication after the key attempts. A stray key
            # passphrase would therefore be tried as the account password
            # instead of DEVICE_PASS and fail as a confusing auth error.
            raise ValueError(
                "passphrase was given without key_filename; a key passphrase "
                "only applies to an explicit SSH key."
            )
        if self.passphrase and self.key_filenames:
            # ncclient has no "publickey only" switch: SSHSession._auth tries
            # the key, then falls back to auth_password(username, password)
            # when its single password slot is non-None. For an encrypted key
            # that slot holds the passphrase, so the passphrase -- not the
            # account password -- can be sent as a password attempt. Pin the
            # dependency behaviour in test_matrix; do not turn this into a
            # "key only" claim.
            log.warning(
                "A key passphrase was supplied. ncclient uses its password slot "
                "for the passphrase and will try it as a password if public-key "
                "authentication fails; use an unencrypted key if that fallback "
                "is unacceptable."
            )
        if not self.username or not (self.password or self.key_filenames):
            raise ValueError(
                "Authentication credentials missing: pass username plus either "
                "password or key_filename, or set DEVICE_USER and DEVICE_PASS / "
                "DEVICE_SSH_KEY in the environment."
            )
        self.auto_commit = auto_commit
        self.log_bodies = log_bodies
        if kwargs:
            log.debug("Ignoring unknown kwargs for NETCONF: %s", sorted(kwargs))

        if not verify:
            log.warning("NETCONF hostkey_verify=False (verify=False) is an explicit lab-only opt-out; never use in production.")
        if log_bodies:
            # Deprecated no-op alias: redacted request/response XML is logged
            # whenever the logger is at DEBUG, with or without this flag.
            # Kept (and warned once here) so older call sites keep
            # constructing; new code should set the log level instead.
            import warnings

            warnings.warn(
                "log_bodies is deprecated; set the logger to DEBUG instead",
                DeprecationWarning,
                stacklevel=2,
            )
        if auto_commit:
            # auto_commit commits the candidate after EVERY edit, so a
            # multi-step change can never be reviewed, validated or rolled
            # back. It is opt-in for that reason; prefer the explicit
            # validate() -> commit() sequence.
            log.warning("NETCONF auto_commit=True commits after every edit; prefer auto_commit=False plus validate() then commit().")

        if not self.host:
            raise ValueError("Either loopback_ip or management_ip must be provided")

        # ncclient exposes one `password` transport parameter and uses it for
        # two things in order: the passphrase that unlocks each
        # `key_filename`, then password authentication if key auth failed
        # (ncclient.transport.ssh.SSHSession._auth). When a key is configured
        # that slot must carry its passphrase or nothing: handing an account
        # password to an *unencrypted* key makes paramiko raise "Password was
        # given but private key is not encrypted", so the key is never tried
        # and the client silently falls back to password auth (or fails on a
        # device that forbids it). Password authentication is therefore not
        # attempted when key_filename is set.
        transport_password = self.passphrase if self.key_filenames else self.password
        log.info(f"Connecting to NETCONF server {self.host}:{self.port}")
        self._manager = manager.connect(
            host=self.host,
            port=self.port,
            username=self.username,
            password=transport_password,
            key_filename=self.key_filenames,
            hostkey_verify=verify,
            timeout=timeout,
            allow_agent=allow_agent,
            look_for_keys=look_for_keys,
            **kwargs
        )
        
        # Capability Discovery (RFC 6241 Sec 8)
        self.server_capabilities = list(self._manager.server_capabilities)
        self.has_candidate = _has_capability(self.server_capabilities, _CAP_CANDIDATE)
        self.has_writable_running = _has_capability(self.server_capabilities, _CAP_WRITABLE_RUNNING)
        # RFC 8526 Sec 3.1.1: NMDA is signalled by an explicit base capability
        # URI. Matching the *module* name is wrong: a device routinely
        # advertises `.../yang:ietf-netconf-nmda?module=ietf-netconf-nmda&...`
        # as a module capability while implementing no NMDA at all. SR Linux is
        # exactly that case -- the previous substring test set has_nmda=True and
        # routed every read to a <get-data> the device rejects with
        # "unknown-element", so 100% of datastore reads failed.
        self.has_nmda = _has_capability(self.server_capabilities, _CAP_NMDA)
        self.has_confirmed_commit = _has_capability(self.server_capabilities, _CAP_CONFIRMED_COMMIT)
        self.has_rollback_on_error = _has_capability(self.server_capabilities, _CAP_ROLLBACK_ON_ERROR)
        # Plain attributes, not methods, for every capability flag: the
        # siblings above are attributes, and a lone method among them is a
        # trap -- `if client.has_validate:` is always truthy (it tests a bound
        # method), so validation would be silently skipped on a device that
        # does not implement it.
        #
        # RFC 6241 Sec 8.6.4.1: 1.1 extends 1.0, so `has_validate` is true for
        # either version (both support the <validate> operation). `test-only`
        # is a 1.1 addition and Sec 7.2 allows <test-option> only with 1.1,
        # hence the separate flag.
        self.has_validate_1_1 = _has_capability(self.server_capabilities, _CAP_VALIDATE_1_1)
        self.has_validate = self.has_validate_1_1 or _has_capability(self.server_capabilities, _CAP_VALIDATE_1_0)
        if self.has_nmda:
            log.info("Device supports NMDA (RFC 8526): reads/writes routed via get-data/edit-data.")
        else:
            log.info("Device does not advertise NMDA; using legacy get/get-config/edit-config.")

        # RFC 6241 Sec 8.3: module capabilities are 'namespace?module=name&...'.
        # Maps module name -> namespace for identityref prefix binding on
        # write and prefix -> module-name normalization on read.
        #
        # Seeded from the COMPILE-TIME map (the modules pyang actually loaded
        # for this client) and then overlaid with what the device advertises.
        # Seeding first matters: an identityref value is an XML QName, so its
        # prefix must be declared in the document (RFC 7950 Sec 9.10.3). If
        # binding depended only on the peer's <hello>, a device that omitted a
        # module capability -- or a value for a module the device never
        # advertised -- would put an undeclared prefix on the wire. The server
        # still wins on conflicts: it is authoritative about what it speaks.
        self.module_namespaces: dict[str, str] = dict(MODULE_NAMESPACES)
        for cap in self.server_capabilities:
            if "?" not in cap:
                continue
            base, _, query = cap.partition("?")
            names = parse_qs(query).get("module")
            if names:
                self.module_namespaces[names[0]] = base
        self.namespace_modules: dict[str, str] = {ns: name for name, ns in self.module_namespaces.items()}
        
        if not self.has_candidate and not self.has_writable_running:
            log.warning("Device advertises neither :candidate nor :writable-running. Modifications may fail.")
            self.default_target = "running"
        else:
            self.default_target = "candidate" if self.has_candidate else "running"

        log.debug(f"Capabilities resolved. Default write target: {self.default_target}")

        from .data_navigators import Data, Operations
        self.data = Data(self, path=[])
        self.operations = Operations(self, path=[])

    def __enter__(self) -> Self:
        """Context manager: lock on entry, release the session on exit.

        Preferred over a bare constructor because `close()` is guaranteed to
        run. `manager.connect()` opens an SSH transport and a NETCONF session
        that the device counts against its session limits; nothing released
        them before this existed except garbage collection.
        """
        try:
            self.lock()
        except Exception:  # noqa: BLE001 - some devices refuse <lock> on :candidate
            log.warning("Could not acquire a NETCONF lock; continuing unlocked.", exc_info=True)
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        # Order matters: never let cleanup mask the original exception.
        try:
            if exc_type is not None:
                log.warning("Exception during transaction, discarding candidate changes.")
                try:
                    self.discard_changes()
                except Exception:  # noqa: BLE001 - best-effort rollback
                    log.warning("discard_changes() failed; the candidate may hold partial changes.", exc_info=True)
        finally:
            try:
                self.unlock()
            except Exception:  # noqa: BLE001 - best-effort unlock
                log.warning("unlock() failed; the lock may persist until the session drops.", exc_info=True)
            self.close()

    def close(self) -> None:
        """Release the NETCONF session and its SSH transport. Idempotent."""
        manager = getattr(self, "_manager", None)
        if manager is None:
            return
        try:
            manager.close_session()
        except Exception:  # noqa: BLE001 - teardown must never raise
            log.debug("close_session() raised during teardown", exc_info=True)
        finally:
            self._manager = None

    def __del__(self) -> None:  # pragma: no cover - GC path
        try:
            self.close()
        except Exception:  # noqa: BLE001
            pass

    @property
    def _mc(self):
        """The live ncclient manager, or a clear error after close()."""
        if getattr(self, "_manager", None) is None:
            raise RuntimeError(
                "NETCONF session is closed; construct a new NetconfClient."
            )
        return self._manager

    def lock(self, target: str | None = None) -> bool:
        target = target or self.default_target
        log.debug(f"Acquiring lock on {target} datastore.")
        return self._handle_rpc(self._mc.lock, target=target).ok

    def unlock(self, target: str | None = None) -> bool:
        target = target or self.default_target
        log.debug(f"Releasing lock on {target} datastore.")
        return self._handle_rpc(self._mc.unlock, target=target).ok

    def _handle_rpc(self, func, *args, **kwargs) -> Any:
        """Centralized dispatch: error handling plus INFO/DEBUG wire logging.

        INFO logs one summary line per request and per response (operation,
        datastore, outcome, size, duration) -- the production trail, with no
        bodies ever. DEBUG adds the redacted raw request/reply XML, so every
        request and every response is visible to an operator who opts in.
        Serialization is skipped entirely unless DEBUG is enabled, so a
        production session at the default level pays nothing for logs nobody
        reads. Every helper on this path is total (never raises, never
        mutates), so logging can neither alter what is sent nor mask a
        device error with its own traceback.
        """
        name = getattr(func, "__name__", "rpc")
        where = kwargs.get("source", kwargs.get("target", ""))
        log.info("NETCONF request: %s%s", name, f" {where}" if where else "")
        debug = log.isEnabledFor(logging.DEBUG)
        if debug:
            log.debug("NETCONF request %s: %s", name, _request_wire(func, args, kwargs))
        start = time.perf_counter()
        try:
            reply = func(*args, **kwargs)
        except RPCError as e:
            # Transform ncclient XML exceptions into standard Python runtime exceptions.
            #
            # ncclient's RPCError exposes `tag`/`type`/`severity` as *properties*
            # over `_tag`/`_type`/`_severity`, which are only populated when
            # ncclient parsed structured <rpc-error> elements. When it raises
            # RPCError with a plain-string errlist (ncclient 0.7 does exactly
            # this for a libyang "InvalidArgument"), `_tag` is never set and
            # touching `e.tag` raises AttributeError -- so the previous handler
            # crashed while formatting and the real device message was lost.
            # Report whatever is available, never raise from the error path.
            parts = [_rpcerror_attr(e, "tag"), f"Type: {_rpcerror_attr(e, 'type')}",
                     f"Severity: {_rpcerror_attr(e, 'severity')}"]
            detail = [_rpcerror_attr(e, "message")]
            for item in getattr(e, "errlist", None) or []:
                if item not in detail:
                    detail.append(str(item))
            if len(detail) == 1 and not detail[0]:
                detail = [_rpcerror_text(e)]
            error_msg = "NETCONF RPC Error: " + " ".join(p for p in parts if p)
            extra = " - ".join(d for d in detail if d)
            if extra:
                error_msg += f" - {extra}"
            log.error(error_msg)
            error = RuntimeError(error_msg)
            # Keep the RFC 6241 <error-tag> machine-readable: plan() falls back
            # to candidate staging on operation-not-supported/invalid-value
            # instead of string-matching the human message.
            setattr(error, "rpc_error_tag", _rpcerror_attr(e, "tag"))
            raise error from e
        except (OSError, ValueError) as e:
            # A transport or parse failure is not an RPC-level error and has no
            # errlist; surface it unchanged rather than losing it.
            log.error("NETCONF transport error: %s", e)
            raise
        elapsed = time.perf_counter() - start
        if debug:
            text, size = _reply_wire(reply)
            log.debug("NETCONF reply %s (%.2fs, %d bytes): %s", name, elapsed, size, text)
        log.info("NETCONF response: %s ok (%.2fs)", name, elapsed)
        return reply

    def retrieve(self, source: str | None = None, filter_xml: str | etree._Element | list[etree._Element] | None = None, content: str = "all", with_defaults: str | None = None, depth: int | str = "unbounded") -> etree._Element | None:
        """Capability-routed retrieval. Defaults to operational state if retrieving all, otherwise running.

        ``filter_xml`` may be one selection node or a list of them; a list is
        how ``Data.retrieve()`` selects several compiled roots in one RPC.
        ncclient's ``build_filter`` wraps a list in a single
        ``<filter type="subtree">`` (RFC 6241 Sec 6).
        """
        requested_depth = validate_depth(depth)
        if source is None:
            source = "running" if content == "config" else "operational"

        if isinstance(filter_xml, str):
            filter_xml = etree.fromstring(filter_xml)

        if requested_depth is not None and not self.has_nmda and filter_xml is None:
            # RFC 6241 has no depth parameter. A finite-depth legacy read
            # without a filter is a whole-datastore read, which the generated
            # navigators exist to prevent. Refuse before the RPC instead of
            # silently ignoring the ceiling.
            raise ValueError(
                "finite depth on legacy NETCONF requires a subtree filter; use "
                "a generated navigator (it builds a depth-bounded filter) or "
                "pass depth='unbounded' explicitly."
            )

        if self.has_nmda:
            # Construct NMDA <get-data> (RFC 8526)
            NMDA_NS = "urn:ietf:params:xml:ns:yang:ietf-netconf-nmda"
            DS_NS = "urn:ietf:params:xml:ns:yang:ietf-datastores"
            
            rpc = etree.Element("{" + NMDA_NS + "}get-data", nsmap={None: NMDA_NS, "ds": DS_NS})
            ds = etree.SubElement(rpc, "{" + NMDA_NS + "}datastore")
            ds.text = f"ds:{source}"
            
            if filter_xml is not None:
                sf = etree.SubElement(rpc, "{" + NMDA_NS + "}subtree-filter")
                if isinstance(filter_xml, (list, tuple)):
                    for item in filter_xml:
                        sf.append(item)
                else:
                    sf.append(filter_xml)
                
            if content in ("config", "nonconfig"):
                cf = etree.SubElement(rpc, "{" + NMDA_NS + "}config-filter")
                cf.text = "true" if content == "config" else "false"
                
            if with_defaults:
                wd = etree.SubElement(rpc, "{" + NMDA_NS + "}with-defaults")
                wd.text = with_defaults

            if requested_depth is not None:
                md = etree.SubElement(rpc, "{" + NMDA_NS + "}max-depth")
                md.text = str(requested_depth)
                
            reply = self._handle_rpc(self._mc.dispatch, rpc)

            # RFC 8526 guarantees output payload wrapper inherits the module namespace.
            # _reply_root keeps ncclient<=0.6 (.ele) and >=0.7 (.xml) working.
            root = _reply_root(reply)
            if root is None:
                return None
            data_node = root.find("{urn:ietf:params:xml:ns:yang:ietf-netconf-nmda}data")
            if data_node is None:
                data_node = root.find("{urn:ietf:params:xml:ns:netconf:base:1.0}data")
            if data_node is None:
                data_node = root.find("data")
            return data_node

        else:
            # Fallback to Legacy <get> and <get-config> (RFC 6241)
            # A single selection element becomes ncclient's (type, criteria)
            # tuple; a list is passed through and build_filter wraps every
            # entry in one <filter type="subtree">.
            if isinstance(filter_xml, etree._Element):
                filter_xml = ("subtree", etree.tostring(filter_xml, encoding="unicode"))
            kwargs = {"with_defaults": with_defaults} if with_defaults else {}
            
            # Legacy <get> does not support querying specific datastores natively, it queries state + running config
            if content in ("all", "nonconfig") or source == "operational":
                reply = self._handle_rpc(self._mc.get, filter=filter_xml, **kwargs)
            else:
                reply = self._handle_rpc(self._mc.get_config, source=source, filter=filter_xml, **kwargs)
            data_ele = getattr(reply, "data_ele", None)
            if data_ele is not None:
                return data_ele
            root = _reply_root(reply)
            if root is None:
                return None
            data_node = root.find("{urn:ietf:params:xml:ns:netconf:base:1.0}data")
            if data_node is None:
                data_node = root.find("data")
            return data_node

    def edit(self, config_xml: str | etree._Element, target: str | None = None, default_operation: str = "merge", test_option: str | None = None, commit: bool | None = None) -> bool:
        """Capability-routed edits. Uses <edit-data> if NMDA is supported, otherwise raw <edit-config>.

        ``test_option="test-only"`` validates without applying and requires
        :validate:1.1 (RFC 6241 Sec 7.2, Sec 8.6.4.1). ``commit`` overrides
        ``auto_commit`` for this call; ``plan()`` passes False so a dry run can
        never commit.
        """
        target = target or self.default_target
        if isinstance(config_xml, str):
            config_xml = etree.fromstring(config_xml)
        if self.has_nmda and test_option:
            raise ValueError(
                "NMDA <edit-data> has no <test-option> (RFC 8526 Sec 2.2); "
                "stage to candidate and call validate() instead"
            )

        if self.has_nmda:
            # Construct NMDA <edit-data> (RFC 8526)
            NMDA_NS = "urn:ietf:params:xml:ns:yang:ietf-netconf-nmda"
            DS_NS = "urn:ietf:params:xml:ns:yang:ietf-datastores"
            
            rpc = etree.Element("{" + NMDA_NS + "}edit-data", nsmap={None: NMDA_NS, "ds": DS_NS})
            ds = etree.SubElement(rpc, "{" + NMDA_NS + "}datastore")
            ds.text = f"ds:{target}"
            
            def_op = etree.SubElement(rpc, "{" + NMDA_NS + "}default-operation")
            def_op.text = default_operation
            
            # <config> is a choice case inside <edit-content>, so it maps transparently without <edit-content>.
            conf = etree.SubElement(rpc, "{" + NMDA_NS + "}config")
            
            # Strip the legacy '<config>' wrapper tag passed by navigators, keeping just the children
            if config_xml.tag.endswith("config"):
                for child in config_xml:
                    conf.append(child)
            else:
                conf.append(config_xml)

            bind_module_prefixes(rpc, self.module_namespaces)
            reply = self._handle_rpc(self._mc.dispatch, rpc)
            success = reply.ok

        else:
            # Fallback to natively constructed Legacy <edit-config> (RFC 6241)
            # We strictly bypass self._mc.edit_config() to avert multiple-root crashes and tag double-wrapping
            NC_NS = "urn:ietf:params:xml:ns:netconf:base:1.0"
            rpc = etree.Element("{" + NC_NS + "}edit-config", nsmap={None: NC_NS})
            tgt = etree.SubElement(rpc, "{" + NC_NS + "}target")
            etree.SubElement(tgt, "{" + NC_NS + "}" + target)
            
            def_op = etree.SubElement(rpc, "{" + NC_NS + "}default-operation")
            def_op.text = default_operation

            # RFC 6241 Sec 7.2: <test-option> may be sent only with
            # :validate:1.1; "test-only" validates without applying
            # (Sec 8.6.4.1). Ordered per the YANG input: target,
            # default-operation, test-option, error-option, config.
            if test_option:
                test_opt = etree.SubElement(rpc, "{" + NC_NS + "}test-option")
                test_opt.text = test_option

            # RFC 6241 Sec 7.2: <error-option>rollback-on-error makes the server
            # stop at the first error-severity <rpc-error> and restore the
            # datastore to its complete state at the start of THIS edit-config,
            # turning a half-applied write into an error and a clean datastore.
            #
            # Deliberately restricted to target == "running":
            #   * On candidate the correct primitive is <discard-changes>, and
            #     Sec 8.5.1 warns this option "can cause other configuration
            #     changes (for example, via other NETCONF sessions) to be
            #     inadvertently altered or removed" in a shared datastore --
            #     candidate is exactly where humans stage work.
            #   * Sec 8.5.1 makes a held lock a precondition for that safety on
            #     shared datastores; callers writing to running are expected to
            #     lock first (the verify CLI refuses to write unlocked).
            # NMDA needs none of this: <edit-data> has no error-option and its
            # error behaviour already corresponds to rollback-on-error
            # (RFC 8526 Sec 3.1.2).
            if target == "running" and self.has_rollback_on_error:
                err_opt = etree.SubElement(rpc, "{" + NC_NS + "}error-option")
                err_opt.text = "rollback-on-error"

            if config_xml.tag.endswith("config"):
                rpc.append(config_xml)
            else:
                conf = etree.SubElement(rpc, "{" + NC_NS + "}config")
                conf.append(config_xml)

            bind_module_prefixes(rpc, self.module_namespaces)
            reply = self._handle_rpc(self._mc.dispatch, rpc)
            success = reply.ok

        effective_commit = self.auto_commit if commit is None else commit
        if success and target == "candidate" and effective_commit:
            self.commit()
        return success

    def plan(self, diff, *, target: str | None = None, show: bool = True) -> PlanResult:
        """Show the surgical edit and dry-run it on the device.

        Tier order: ``test-only`` when :validate:1.1 is advertised (no write),
        else candidate staging + ``<validate>`` + discard, else message only.
        A plan never applies to running and never commits.
        """
        config = build_config(diff, self.module_namespaces)
        xml = etree.tostring(config, pretty_print=True, encoding="unicode")
        if show:
            print(xml)
        target = target or self.default_target

        if self.has_nmda:
            return self._plan_via_candidate(config, xml)

        if self.has_validate_1_1:
            try:
                ok = self.edit(
                    config, target=target, test_option="test-only", commit=False
                )
            except RuntimeError as exc:
                tag = getattr(exc, "rpc_error_tag", None)
                if tag not in ("operation-not-supported", "invalid-value"):
                    raise
                log.warning(
                    "Device rejected test-only (%s); falling back to candidate staging.",
                    tag,
                )
                return self._plan_via_candidate(config, xml)
            return PlanResult(xml=xml, ok=ok, validated="syntax")

        if self.has_candidate:
            return self._plan_via_candidate(config, xml)

        log.warning(
            "Device offers neither :validate:1.1 nor :candidate; the plan is "
            "message-only and was NOT validated on the device."
        )
        return PlanResult(xml=xml, ok=None, validated="none")

    def _plan_via_candidate(self, config: etree._Element, xml: str) -> PlanResult:
        if not self.has_candidate:
            raise RuntimeError(
                "Device has no :candidate datastore, so a plan cannot be staged "
                "for validation."
            )
        if not self.lock("candidate"):
            raise RuntimeError(
                "Could not lock candidate; refusing to stage a plan."
            )
        staged = False
        try:
            if not self._candidate_is_clean():
                raise RuntimeError(
                    "candidate already holds uncommitted changes; refusing to "
                    "stage a plan (discard-changes would destroy them)."
                )
            staged = True
            ok = self.edit(config, target="candidate", commit=False)
            validated = "edit"
            if ok and self.has_validate:
                ok = self.validate(source="candidate")
                validated = "datastore"
            return PlanResult(xml=xml, ok=ok, validated=validated)
        finally:
            if staged:
                try:
                    self.discard_changes()
                except Exception:
                    log.exception(
                        "Failed to discard the staged plan; candidate may still hold it."
                    )
            try:
                self.unlock("candidate")
            except Exception:
                log.exception("Failed to release the candidate lock after plan().")

    def _candidate_is_clean(self) -> bool:
        candidate = self.retrieve(source="candidate", content="config")
        running = self.retrieve(source="running", content="config")
        return _c14n(candidate) == _c14n(running)

    def reconcile(self, diff, *, target: str | None = None, commit: bool = True) -> bool:
        """Apply the surgical edit and (by default) commit it.

        ``commit=True`` is the default even when ``auto_commit`` is False:
        ``plan()`` is expected to run first. ``auto_commit`` never applies
        here, so the edit cannot be committed before validation.
        """
        config = build_config(diff, self.module_namespaces)
        target = target or self.default_target

        if target == "candidate" and self.has_candidate:
            if not self.lock("candidate"):
                raise RuntimeError(
                    "Could not lock candidate; refusing to reconcile."
                )
            staged = False
            try:
                if not self._candidate_is_clean():
                    raise RuntimeError(
                        "candidate already holds uncommitted changes; refusing "
                        "to reconcile (commit would include them)."
                    )
                staged = True
                ok = self.edit(config, target="candidate", commit=False)
                if ok and self.has_validate:
                    ok = self.validate(source="candidate")
                if ok and commit:
                    ok = self.commit()
                if not ok:
                    self.discard_changes()
                    staged = False
                return ok
            except Exception:
                if staged:
                    try:
                        self.discard_changes()
                    except Exception:
                        log.exception(
                            "Failed to discard the failed reconcile; candidate may still hold it."
                        )
                raise
            finally:
                try:
                    self.unlock("candidate")
                except Exception:
                    log.exception("Failed to release the candidate lock after reconcile().")

        return self.edit(config, target=target, commit=False)

    def commit(self) -> bool:
        if not self.has_candidate:
            log.debug("Commit requested, but device lacks :candidate capability. Ignoring.")
            return True
        reply = self._handle_rpc(self._mc.commit)
        return reply.ok

    def validate(self, source: str | None = None) -> bool:
        """Validate datastore contents without touching the running config.

        RFC 6241 Sec 8.6.4.1: the `<validate>` operation takes an optional
        `<source>` naming the datastore to validate --

            <validate><source><candidate/></source></validate>

        There is NO `<validate-source>` RPC in RFC 6241; an earlier version of
        this client invented one and every conformant server answered
        "unknown-element". (The `:validate:1.1` capability instead extends
        `<edit-config>` to validate an inline `<config>`, Sec 8.6.5.1.)

        This is the safe sequence the generated `auto_commit=False` default
        exists for:

            client.edit(target="candidate", ...)
            client.validate(source="candidate")
            client.commit()
        """
        NC_NS = "urn:ietf:params:xml:ns:netconf:base:1.0"
        if not self.has_validate:
            log.warning("Device does not advertise the :validate capability; cannot validate.")
            return False

        rpc = etree.Element("{" + NC_NS + "}validate", nsmap={None: NC_NS})
        if source:
            src = etree.SubElement(rpc, "{" + NC_NS + "}source")
            etree.SubElement(src, "{" + NC_NS + "}" + source)
        reply = self._handle_rpc(self._mc.dispatch, rpc)
        return bool(getattr(reply, "ok", True))

    def discard_changes(self) -> bool:
        if not self.has_candidate: return True
        return self._handle_rpc(self._mc.discard_changes).ok

    def rpc(self, rpc_xml: etree._Element) -> etree._Element | None:
        bind_module_prefixes(rpc_xml, self.module_namespaces)
        reply = self._handle_rpc(self._mc.dispatch, rpc_xml)
        return _reply_root(reply)