from typing import Any, Literal
from collections import defaultdict

from pydantic import BaseModel, ConfigDict, model_validator


class YangBaseModel(BaseModel):
    """Base for all YANG-derived models.
    Add exclude fields based on json_schema_extra['is_config'] and content required.
    """
    model_config = ConfigDict(
        extra="forbid",
        validate_assignment=True,
        defer_build=True,
        validate_default=True,
        # Accept Python field names as well as wire aliases on input,
        # matching the NETCONF model config (protocol parity).
        populate_by_name=True
    )

    @model_validator(mode='after')
    def _enforce_yang_choices(self) -> 'YangBaseModel':
        provided_fields = self.model_fields_set
        if not provided_fields:
            return self
            
        active_cases = defaultdict(set)
        
        for field_name in provided_fields:
            field_info = self.model_fields.get(field_name)
            if not field_info or not field_info.json_schema_extra:
                continue
                
            choice_mapping = field_info.json_schema_extra.get('choice_mapping')
            if choice_mapping:
                for choice_name, case_name in choice_mapping.items():
                    active_cases[choice_name].add(case_name)
                    
        for choice_name, cases in active_cases.items():
            if len(cases) > 1:
                raise ValueError(
                    f"YANG Schema Violation: choice '{choice_name}' cases are mutually exclusive. "
                    f"Found nodes from multiple cases: {list(cases)}"
                )
        return self

    def model_dump(self, *, content: Literal["config", "all", "nonconfig"] = "all", **kwargs: Any) -> dict[str, Any]:
        # Force JSON mode to ensure 64-bit numbers become strings and Enums become values
        kwargs.setdefault("mode", "json")
        kwargs.setdefault("by_alias", True)

        if content == "all":
            return super().model_dump(**kwargs)

        data = super().model_dump(**kwargs)
        # Prune non-matching nodes recursively (RFC 8040 §4.5.2 content
        # semantics): pydantic's `exclude` only applies at the top level, so
        # walk the dumped tree using each level's own is_config flags. Runs
        # after super().model_dump so it composes with exclude_unset and any
        # caller-passed exclude.
        type(self)._prune_content(data, content, by_alias=kwargs["by_alias"])
        return data

    @classmethod
    def _prune_content(cls, data: Any, content: str, by_alias: bool) -> None:
        """Drop in place every subtree holding no node that matches content.

        Bottom-up: children are pruned first, then a mismatching node is
        dropped only when nothing matchable remains below it. This keeps
        ancestor shells (e.g. a config container above a state leaf in a
        ``nonconfig`` dump) while never leaking mismatched leaves. Emptied
        *matching* containers are retained: the IR does not track presence
        containers, so dropping them could corrupt round-trips, and an empty
        shell is harmless in PATCH/PUT bodies.
        """
        if not isinstance(data, dict):
            return
        for field_name, field_info in cls.model_fields.items():
            alias = field_info.alias
            key = alias if by_alias and alias and alias in data else field_name
            if key not in data:
                continue
            extra = field_info.json_schema_extra
            is_config = extra.get("is_config", True) if isinstance(extra, dict) else True
            match = (content == "config") == bool(is_config)
            value = data[key]
            sub = _child_yang_model(field_info.annotation)
            if sub is not None:
                if isinstance(value, dict):
                    sub._prune_content(value, content, by_alias)
                elif isinstance(value, list):
                    for item in value:
                        sub._prune_content(item, content, by_alias)
            # A mismatching leaf/leaf-list always drops. A mismatching
            # container/list keeps an ancestor shell only when a matchable
            # descendant remains, so state under config (or vice versa) never
            # leaks but RFC 8040 hierarchy is preserved.
            keep_shell = (
                sub is not None
                and isinstance(value, (dict, list))
                and _has_content(value)
            )
            if not match and not keep_shell:
                del data[key]


def _has_content(value: Any) -> bool:
    """True when a pruned subtree still holds at least one live value."""
    if isinstance(value, dict):
        return any(_has_content(v) for v in value.values())
    if isinstance(value, list):
        return any(_has_content(v) for v in value)
    return value is not None


def _child_yang_model(annotation: Any) -> type[YangBaseModel] | None:
    """Unwrap Annotated/Optional/Union/list to find a single YangBaseModel subclass.

    Returns None when ambiguous (union of several models) or absent, in which
    case the subtree is left unpruned rather than pruned wrongly.
    """
    from typing import get_args

    found: set[type[YangBaseModel]] = set()

    def walk(ann: Any) -> None:
        if isinstance(ann, type):
            if issubclass(ann, YangBaseModel):
                found.add(ann)
        for arg in get_args(ann):
            walk(arg)

    walk(annotation)
    if len(found) == 1:
        return found.pop()
    return None