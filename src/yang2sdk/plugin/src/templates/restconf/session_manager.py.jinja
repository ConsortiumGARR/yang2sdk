from __future__ import annotations

import logging
import os
import socket
from typing import Any

import requests
from requests.adapters import HTTPAdapter
from urllib3 import PoolManager

log = logging.getLogger(__name__)
log.addHandler(logging.NullHandler())


class TCPKeepAliveAdapter(HTTPAdapter):
    def __init__(self, idle=60, interval=60, count=6, **kwargs):
        self._idle = idle
        self._interval = interval
        self._count = count
        super().__init__(**kwargs)

    def init_poolmanager(self, connections, maxsize, block=False, **pool_kwargs):
        pool_kwargs["socket_options"] = self._socket_options()
        self.poolmanager = PoolManager(
            num_pools=connections,
            maxsize=maxsize,
            block=block,
            **pool_kwargs,
        )

    def proxy_manager_for(self, proxy, **proxy_kwargs):
        proxy_kwargs["socket_options"] = self._socket_options()
        return super().proxy_manager_for(proxy, **proxy_kwargs)

    def _socket_options(self):
        options = [
            (socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1),
        ]

        if hasattr(socket, "TCP_KEEPIDLE"):
            options.append((socket.IPPROTO_TCP, socket.TCP_KEEPIDLE, self._idle))
        if hasattr(socket, "TCP_KEEPINTVL"):
            options.append((socket.IPPROTO_TCP, socket.TCP_KEEPINTVL, self._interval))
        if hasattr(socket, "TCP_KEEPCNT"):
            options.append((socket.IPPROTO_TCP, socket.TCP_KEEPCNT, self._count))

        return options


# Substring match against lower-cased keys. `passphrase` is the important
# addition: it contains neither "password" nor "passwd", so NTP/TACACS/RADIUS
# authenticator passphrases were written to the log in cleartext whenever
# log_bodies was enabled. Bare "key" is deliberately absent -- a `key` leaf is
# far more often a primary key than a secret.
_SENSITIVE_KEYS = (
    "password", "passwd", "passphrase", "secret", "token", "auth", "community",
    "private-key", "privatekey", "psk", "pre-shared", "preshared", "credential",
    "credentials", "md5", "username",
)


def _redact(obj: Any, _depth: int = 0) -> Any:
    """Redact sensitive values and truncate bodies for safe logging.

    Never logs credentials; bodies only at DEBUG behind log_bodies opt-in.
    """
    if _depth > 4:
        return "...[truncated depth]"
    if isinstance(obj, dict):
        out: dict[Any, Any] = {}
        for k, v in obj.items():
            if isinstance(k, str) and any(s in k.lower() for s in _SENSITIVE_KEYS):
                out[k] = "***redacted***"
            else:
                out[k] = _redact(v, _depth + 1)
        return out
    if isinstance(obj, (list, tuple)):
        return [_redact(v, _depth + 1) for v in obj][:50]
    if isinstance(obj, str) and len(obj) > 2000:
        return obj[:2000] + f"...[truncated {len(obj) - 2000} chars]"
    return obj


class RestconfClient:
    """Restconf API client.

    Swappable with NetconfClient: core kwargs (loopback_ip, management_ip,
    port, username, password, verify, log_bodies, timeout) share names and
    secure defaults; protocol extras live in **kwargs (scheme here).
    """

    def __init__(
        self,
        loopback_ip: str | None = None,
        management_ip: str | None = None,
        port: int = 8443,
        username: str | None = None,
        password: str | None = None,
        verify: bool = True,
        scheme: str = "https",
        log_bodies: bool = False,
        timeout: tuple[int, int] | int = (10, 2400),
        **kwargs: Any,
    ):
        self.url = None
        self.fallback_url = None
        self.log_bodies = log_bodies
        if kwargs:
            # Swallow NETCONF-only kwargs (e.g. auto_commit) for swap parity.
            log.debug("Ignoring protocol-specific kwargs for RESTCONF: %s", sorted(kwargs))

        if scheme not in ("http", "https"):
            raise ValueError("scheme must be 'http' or 'https'")
        if scheme == "http":
            # Explicit plaintext opt-out for lab/simulators (e.g. notconf
            # exposes RESTCONF over plain HTTP on port 80). Never the default.
            log.warning("RESTCONF using plaintext HTTP (verify/TLS disabled by scheme). Lab/simulator use only.")
        if not verify:
            log.warning("RESTCONF verify=False is an explicit opt-out for lab/self-signed use; never use in production.")
        if log_bodies:
            log.warning("RESTCONF log_bodies=True may log config/secrets; debug use only, never in production.")

        self.urls = []
        if loopback_ip:
            self.urls.append(f"{scheme}://{loopback_ip}:{port}/restconf")
        if management_ip:
            self.urls.append(f"{scheme}://{management_ip}:{port}/restconf")

        if not self.urls:
            raise ValueError("Either loopback_ip or management_ip must be provided")

        self._session = requests.Session()

        adapter = TCPKeepAliveAdapter(idle=60, interval=60, count=6)
        self._session.mount("https://", adapter)
        self._session.mount("http://", adapter)

        self._session.verify = verify
        self._session.trust_env = verify  # Disable env vars if TLS verification is off
        self._session.headers.update({"Content-Type": "application/yang-data+json"})

        # Credentials come from caller args or the environment at runtime;
        # nothing is baked into generated code. Resolution order is
        # DEVICE_USER -> DEVICE_USERNAME / DEVICE_PASS -> DEVICE_PASSWORD,
        # and it is identical in the NETCONF template: the two protocols used
        # to read the pairs in opposite order, so a host exporting both
        # names authenticated as two different identities depending on the
        # transport. Failing closed is deliberate -- an unauthenticated
        # RESTCONF session would silently 401 on the first call.
        user = username or os.environ.get("DEVICE_USER") or os.environ.get("DEVICE_USERNAME")
        pw = password or os.environ.get("DEVICE_PASS") or os.environ.get("DEVICE_PASSWORD")
        if not user or not pw:
            raise ValueError(
                "Authentication credentials missing: pass username/password, "
                "or set DEVICE_USER/DEVICE_USERNAME and "
                "DEVICE_PASS/DEVICE_PASSWORD in the environment."
            )
        self._session.auth = (user, pw)

        from .data_navigators import Data, Operations

        self.data = Data(self, "/data", "")
        self.operations = Operations(self, "/operations", "")
        self._timeout = timeout

    def close(self) -> None:
        """Release the underlying HTTP connection pool.

        Protocol parity with `NetconfClient.close()`: a generated client is a
        long-lived object holding a `requests.Session`, and without this the
        only way to drop its keep-alive sockets is to let the garbage
        collector do it, which keeps a TLS session and its fds alive well
        past the last call. Idempotent, and safe to call from `__del__`.
        """
        session, self._session = getattr(self, "_session", None), None
        if session is not None:
            session.close()

    def __enter__(self) -> "RestconfClient":
        return self

    def __exit__(self, *exc: object) -> None:
        self.close()

    def __del__(self) -> None:
        try:
            self.close()
        except Exception:  # noqa: BLE001, S110 - interpreter shutdown
            pass

    def _request(self, method: str, path: str, **kwargs: Any) -> dict:
        """Make authenticated API request."""
        if getattr(self, "_session", None) is None:
            raise RuntimeError(
                "RESTCONF session is closed; construct a new RestconfClient."
            )
        errors = []

        for base_url in self.urls:
            url = base_url + path
            try:
                # AGENTS.md Safety: full bodies never at INFO in production
                # paths; method+URL+status at INFO, bodies at DEBUG opt-in.
                log.info("Request: %s %s", method, url)
                if self.log_bodies:
                    log.debug("Request body: %s", _redact(kwargs.get("json")))
                response = self._session.request(method, url, timeout=self._timeout, **kwargs)

                log.info("Response: %s", response.status_code)
                if self.log_bodies:
                    log.debug("Response body: %s", _redact(response.text))
                response.raise_for_status()
                return response.json() if response.text.strip() else {}

            except (requests.ConnectionError, requests.Timeout) as e:
                msg = f"Failed to connect to {base_url}: {e}"
                log.exception(msg)
                errors.append(e)
                continue  # Try the next URL in self.urls

            except requests.HTTPError as e:
                status = e.response.status_code
                log.warning("HTTP %s on %s %s", status, method, url)
                if self.log_bodies:
                    log.debug("HTTP %s body: %s", status, _redact(e.response.text))
                # The body carries device config and credentials, and every
                # caller logs the exception it receives. Report the status and
                # the YANG error-tag (RFC 8040 Sec 7); the body stays behind
                # the log_bodies opt-in, which is what the logging-hygiene
                # contract in AGENTS.md actually requires.
                detail = ""
                try:
                    errors = e.response.json().get("ietf-restconf:errors") or {}
                    first = (errors.get("error") or [{}])[0]
                    tag = first.get("error-tag") or first.get("error-message")
                    if tag:
                        detail = f" ({tag})"
                except Exception:  # noqa: BLE001 - non-JSON error page
                    detail = ""
                raise requests.HTTPError(
                    f"HTTP {status}{detail} on {method} {url}",
                    response=e.response,
                ) from e

        # If we get here, all URLs failed
        msg = f"All connection attempts to {self.urls} have failed."
        raise ExceptionGroup(msg, errors)